// NORTEX INC. - REAL MONEY PROTOCOL SCHEMA
// Expense & B2BOrder models for Real Business Logic

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// CORE BUSINESS ENTITIES
// ==========================================

model Tenant {
  id                   String    @id @default(cuid())
  businessName         String
  type                 String    @default("FERRETERIA") // FERRETERIA | PULPERIA | LENDER | RETAIL | DISTRIBUIDORA | MISCELANEA
  taxId                String    @unique
  slug                 String?   @unique // URL amigable para catálogo público (ej: "ferreteria-jose")
  walletBalance        Decimal   @default(0) @db.Decimal(18, 4)
  creditLimit          Decimal   @default(0) @db.Decimal(18, 4)
  // NULL = "sin datos suficientes": un tenant nuevo NO tiene score hasta que
  // el motor real (services/scoring.ts) lo calcula desde historial operativo.
  // Nunca sembrar un valor fantasma; el número solo existe si hay con qué.
  creditScore          Int?
  subscriptionStatus   String    @default("TRIAL") // TRIAL | ACTIVE | PAST_DUE | CANCELLED
  stripeCustomerId     String? // Stripe Customer ID (cus_xxx)
  stripeSubscriptionId String? // Stripe Subscription ID (sub_xxx)
  subscriptionEndsAt   DateTime? // Fecha de vencimiento de la suscripción activa
  trialEndsAt          DateTime? // Fecha límite del trial gratuito (14 días desde registro)
  theftAlertThreshold  Decimal   @default(500) @db.Decimal(10, 2)
  // Alertas de gaveta del agente bancario (Fase C, nullable = sin alerta):
  // mínimo = no poder pagar retiros/remesas; máximo = exceso de efectivo
  // (riesgo de robo → sugerir entrega al banco).
  agentCashMin         Decimal?  @db.Decimal(18, 4)
  agentCashMax         Decimal?  @db.Decimal(18, 4)
  // Costo de entrega plano del catálogo público (lo fija el negocio; el
  // cliente NUNCA lo manda — se calcula server-side al crear el Pedido).
  deliveryFee          Decimal   @default(0) @db.Decimal(10, 2)
  // Inventario: si true, las ventas/salidas pueden dejar el stock en negativo
  // (negocios que venden sin contar; el Kardex refleja la realidad). Default false.
  allowNegativeStock   Boolean   @default(false)
  // Caja: si true, abrir la caja exige el PIN del empleado. APAGADO por defecto
  // —el PIN era puro trámite para el dueño de una pulpería, y el muro caía a
  // medio cobro—. Se prende en el negocio donde VARIOS CAJEROS COMPARTEN UNA
  // MISMA CUENTA: ahí el PIN es lo único que le pone nombre a un faltante del
  // arqueo. Si cada quien entra con su usuario, `Shift.userId` ya lo resuelve.
  requireCashierPin    Boolean   @default(false)
  // Política operativa de devoluciones. Treinta días es el default acordado;
  // una solicitud vencida puede documentarse, pero siempre requiere aprobación.
  returnWindowDays     Int       @default(30)
  // Desglose de lotes por bodega: OFF preserva el comportamiento legado.
  // La activación se hará explícitamente por tenant, nunca desde una migración.
  batchWarehouseLedgerMode        String    @default("OFF") @db.VarChar(16)
  batchWarehouseLedgerActivatedAt DateTime?
  // Campos Fiscales DGI
  // GENERAL preserva el cálculo y desglose fiscal de todos los tenants
  // existentes; la versión permite congelar qué configuración usó cada documento.
  fiscalRegime         String    @default("GENERAL") @db.VarChar(32)
  fiscalRegimeVersion  Int       @default(1)
  address              String? // Dirección fiscal
  phone                String? // Teléfono del negocio
  dgiAuthCode          String? // Código autorización DGI (AIMS-xxxx)
  dgiAuthDate          DateTime? // Fecha de autorización DGI
  createdAt            DateTime  @default(now())

  users                     User[]
  customers                 Customer[]
  suppliers                 Supplier[]
  employees                 Employee[]
  sales                     Sale[]
  shifts                    Shift[]
  auditLogs                 AuditLog[]
  expenses                  Expense[]
  b2bOrders                 B2BOrder[]
  products                  Product[]
  productBatches            ProductBatch[]
  kardexMovements           KardexMovement[]
  stockCounts               StockCount[]
  purchases                 Purchase[]
  purchaseOrders            PurchaseOrder[]
  manualPayments            ManualPayment[]
  quotations                Quotation[]
  invitations               Invitation[]
  cashMovements             CashMovement[]
  shiftCloseReports         ShiftCloseReport[]
  productReturns            ProductReturn[]
  serialNumbers             SerialNumber[]
  warehouses                Warehouse[]
  productStocks             ProductStock[]
  stockTransfers            StockTransfer[]
  sellerProducts            SellerProduct[]
  accounts                  Account[]
  journalEntries            JournalEntry[]
  fiscalRetentions          FiscalRetention[]
  invoiceSeries             InvoiceSeries[]
  publicOrders              PublicOrder[]
  capitalLoans              CapitalLoan[]
  tenantCapabilities        TenantCapability[]
  scaleLabelProfiles        ScaleLabelProfile[]
  scaleLabelProfileVersions ScaleLabelProfileVersion[]
  scaleProductMappings      ScaleProductMapping[]
  scaleDevices              ScaleDevice[]
  saleMeasurements          SaleMeasurement[]
  saleItemBatchAllocations  SaleItemBatchAllocation[]
  customerInteractions      CustomerInteraction[]
  supplierContacts          SupplierContact[]
  supplierDocuments         SupplierDocument[]
  supplierPayments          SupplierPayment[]
  goodsReceipts             GoodsReceipt[]
  goodsReceiptItems         GoodsReceiptItem[]
  purchaseMatchAllocations  PurchaseMatchAllocation[]
  purchaseMatchExceptions   PurchaseMatchException[]
  procurementPolicy         ProcurementPolicy?
  productBatchWarehouseStocks ProductBatchWarehouseStock[]
  productBatchLedgerEntries   ProductBatchLedgerEntry[]
  purchaseOrderCloseShorts    PurchaseOrderCloseShort[]
  purchaseOrderCloseShortItems PurchaseOrderCloseShortItem[]
  supplierReturns              SupplierReturn[]
  supplierReturnItems          SupplierReturnItem[]
  supplierCreditNotes          SupplierCreditNote[]
  supplierCreditNoteLines      SupplierCreditNoteLine[]
  supplierCreditApplications   SupplierCreditApplication[]
  saleCorrectionRequests       SaleCorrectionRequest[]
  saleCorrectionLines          SaleCorrectionLine[]
  approvalGrants               ApprovalGrant[]
  returnRefunds                ReturnRefund[]
  returnInspections            ReturnInspection[]
  customerCreditEntries        CustomerCreditEntry[]
  productReturnItems           ProductReturnItem[]

  // HR Module
  leaveRequests          LeaveRequest[]
  payrollRuns            PayrollRun[]
  payrollLines           PayrollLine[]
  salaryAdvances         SalaryAdvance[]
  terminationSettlements TerminationSettlement[]

  // Delivery module
  motorizados Motorizado[]
  pedidos     Pedido[]

  // WhatsApp channel
  whatsappSessions        WhatsappSession[]
  whatsappInboundMessages WhatsappInboundMessage[]
}

model User {
  id        String    @id @default(cuid())
  tenantId  String
  email     String?   @unique // Optional: some users created via PIN invitation have no email
  password  String
  name      String
  role      String    @default("EMPLOYEE") // OWNER, ADMIN, MANAGER, CASHIER, VIEWER
  status    String    @default("ACTIVE") // ACTIVE, DISABLED
  lastLogin DateTime?
  invitedBy String?
  createdAt DateTime  @default(now())

  tenant                           Tenant                     @relation(fields: [tenantId], references: [id])
  shifts                           Shift[]
  payments                         Payment[]
  salesSold                        Sale[]                     @relation("SaleSeller")
  // Ventas que este usuario ANULÓ (DGI-5): la anulación siempre tiene autor.
  salesCancelled                   Sale[]                     @relation("SaleCanceller")
  customersAssigned                Customer[]                 @relation("CustomerSeller")
  loadWarehouses                   Warehouse[]                @relation("SellerLoadWarehouse")
  catalogAssigned                  SellerProduct[]            @relation("SellerCatalog")
  auditLogs                        AuditLog[]
  productsCreated                  Product[]
  kardexMovements                  KardexMovement[]
  stockCounts                      StockCount[]
  passwordResets                   PasswordReset[]
  cashMovements                    CashMovement[]
  employeeProfile                  Employee?
  loansAssigned                    Loan[]                     @relation("LoanCollector")
  whatsappNumber                   String?                    @unique @db.VarChar(20)
  whatsappSession                  WhatsappSession?
  scaleLabelProfileVersionsCreated ScaleLabelProfileVersion[] @relation("ScaleLabelProfileVersionCreator")
  scaleDevicesCreated              ScaleDevice[]              @relation("ScaleDeviceCreator")
  saleMeasurements                 SaleMeasurement[]          @relation("SaleMeasurementUser")
  customerInteractionsCreated      CustomerInteraction[]      @relation("CustomerInteractionCreator")
  supplierContactsCreated          SupplierContact[]           @relation("SupplierContactCreator")
  supplierDocumentsUploaded        SupplierDocument[]          @relation("SupplierDocumentUploader")
  supplierPaymentsCreated          SupplierPayment[]           @relation("SupplierPaymentCreator")
  goodsReceiptsReceived            GoodsReceipt[]               @relation("GoodsReceiptReceiver")
  purchasesMatchResolved           Purchase[]                   @relation("PurchaseMatchResolver")
  purchaseMatchExceptionsResolved  PurchaseMatchException[]     @relation("PurchaseMatchExceptionResolver")
  procurementPoliciesUpdated       ProcurementPolicy[]          @relation("ProcurementPolicyUpdater")
  productBatchLedgerEntriesCreated ProductBatchLedgerEntry[]     @relation("ProductBatchLedgerEntryCreator")
  purchaseOrderCloseShortsCreated  PurchaseOrderCloseShort[]     @relation("PurchaseOrderCloseShortCreator")
  supplierReturnsCreated            SupplierReturn[]              @relation("SupplierReturnCreator")
  supplierCreditNotesCreated        SupplierCreditNote[]          @relation("SupplierCreditNoteCreator")
  supplierCreditApplicationsCreated SupplierCreditApplication[]   @relation("SupplierCreditApplicationCreator")

  @@index([tenantId])
  // Retención: escaneo de usuarios activos por recencia de login (métricas admin
  // + detección de dormancia). Índice agregado con la query que lo usa.
  @@index([lastLogin])
}

// ==========================================
// INVITACIONES DE EQUIPO
// ==========================================

model Invitation {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  role      String // MANAGER, CASHIER, VIEWER
  token     String   @unique
  status    String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  invitedBy String // userId del que invitó
  createdAt DateTime @default(now())
  expiresAt DateTime // 48 horas después de creación

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([token])
}

// ==========================================
// RECUPERACIÓN DE CONTRASEÑA
// ==========================================

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([token])
}

model Customer {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  taxId       String?
  phone       String?
  email       String?
  address     String?  @db.Text
  creditLimit Decimal  @default(0) @db.Decimal(10, 2)
  currentDebt Decimal  @default(0) @db.Decimal(10, 2)
  // Saldo a favor autoritativo. Cada cambio deja además una entrada inmutable
  // en CustomerCreditEntry; no se recalcula sumando floats en el cliente.
  storeCreditBalance Decimal @default(0) @db.Decimal(18, 4)
  isBlocked   Boolean  @default(false)
  // Cliente mayorista: el POS le aplica el precio de mayoreo desde la unidad 1.
  isWholesale Boolean  @default(false)
  // Vendedores: cartera de ruta — a qué vendedor (User del MISMO tenant)
  // pertenece este cliente. Nullable = sin asignar. La validación de que el
  // User asignado sea del mismo tenant y no esté DISABLED vive en los
  // endpoints (POST/PUT /api/customers), no en la BD. Los User nunca se
  // borran físicamente (solo status DISABLED), así que la FK no deja huérfanos.
  sellerId    String?
  createdAt   DateTime @default(now())

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  seller       User?                 @relation("CustomerSeller", fields: [sellerId], references: [id])
  sales        Sale[]
  interactions CustomerInteraction[]
  creditEntries CustomerCreditEntry[]

  loans Loan[]

  @@index([tenantId])
  // Filtro de cartera: GET /api/customers?sellerId=… — índice con su query.
  @@index([tenantId, sellerId])
}

/// Gestión comercial/cobranza persistida en la ficha del cliente. El texto es
/// operativo y tenant-scoped; las bitácoras guardan solo metadatos, no su nota.
model CustomerInteraction {
  id             String    @id @default(cuid())
  tenantId       String
  customerId     String
  type           String // NOTE | CALL | WHATSAPP | VISIT | PROMISE
  note           String    @db.Text
  status         String    @default("OPEN") // OPEN | COMPLETED | CANCELLED
  promisedAmount Decimal?  @db.Decimal(10, 2)
  promisedAt     DateTime?
  followUpAt     DateTime?
  completedAt    DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creator  User     @relation("CustomerInteractionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, status, followUpAt])
  @@index([createdBy])
}

model Supplier {
  id                 String    @id @default(cuid())
  tenantId           String
  name               String
  ruc                String?
  contactName        String?
  phone              String?
  email              String?
  address            String?   @db.Text
  category           String?
  status             String    @default("ACTIVE") @db.VarChar(32) // ACTIVE | SUSPENDED | BLOCKED
  legalType          String?   @db.VarChar(32) // NATURAL | JURIDICAL
  fiscalCategory     String?   @db.VarChar(64)
  currency           String    @default("NIO") @db.VarChar(3)
  paymentTermsDays   Int?
  creditLimit        Decimal?  @db.Decimal(18, 4)
  leadTimeDays       Int?
  minimumOrderAmount Decimal?  @db.Decimal(18, 4)
  notes              String?   @db.Text
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  tenant             Tenant          @relation(fields: [tenantId], references: [id])
  purchases          Purchase[]
  purchaseOrders     PurchaseOrder[]
  defaultForProducts Product[]       @relation("DefaultSupplier")
  contacts           SupplierContact[]
  documents          SupplierDocument[]
  payments           SupplierPayment[]
  supplierReturns    SupplierReturn[]
  creditNotes        SupplierCreditNote[]
  creditApplications SupplierCreditApplication[]

  @@index([tenantId])
  @@index([tenantId, deletedAt, name])
  @@index([tenantId, status, name])
  @@index([tenantId, ruc])
}

/// Personas de contacto del proveedor. Cada registro conserva tenantId para que
/// las consultas y autorizaciones no dependan solo de la relación indirecta.
model SupplierContact {
  id         String   @id @default(cuid())
  tenantId   String
  supplierId String
  name       String
  title      String?
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  notes      String?  @db.Text
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  creator  User     @relation("SupplierContactCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId, supplierId])
  @@index([tenantId, email])
  @@index([createdBy])
}

/// Metadatos de documentos privados. El archivo vive fuera de la base de datos;
/// storageKey es una referencia opaca y nunca una URL pública.
model SupplierDocument {
  id         String    @id @default(cuid())
  tenantId   String
  supplierId String
  kind       String    @db.VarChar(64)
  fileName   String    @db.VarChar(255)
  storageKey String    @db.VarChar(512)
  mimeType   String?   @db.VarChar(127)
  sizeBytes  Int?
  sha256     String?   @db.VarChar(64)
  expiresAt  DateTime?
  uploadedBy String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  uploader User     @relation("SupplierDocumentUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([tenantId, supplierId, createdAt])
  @@index([tenantId, kind, expiresAt])
  @@index([uploadedBy])
}

// ==========================================
// COMPRAS & CUENTAS POR PAGAR
// ==========================================

model Purchase {
  id                     String    @id @default(cuid())
  tenantId               String
  supplierId             String
  invoiceNumber          String // # Factura del proveedor
  date                   DateTime  @default(now())
  postingDate            DateTime?
  dueDate                DateTime? // Fecha de vencimiento (para crédito)
  subtotal               Decimal   @db.Decimal(12, 2)
  tax                    Decimal   @default(0) @db.Decimal(12, 2)
  // Foto fiscal de la compra: los defaults conservan el régimen general en el
  // histórico y NULL distingue el crédito fiscal que nunca se persistió.
  fiscalRegimeAtPurchase String    @default("GENERAL") @db.VarChar(32)
  creditableTax          Decimal?  @db.Decimal(18, 4)
  total                  Decimal   @db.Decimal(12, 2)
  status                 String    @default("COMPLETED") // COMPLETED | PENDING_PAYMENT | PARTIALLY_PAID
  paymentMethod          String // CASH | CREDIT
  notes                  String?   @db.Text
  createdBy              String
  createdAt              DateTime  @default(now())
  // Recepción de una Orden de Compra (null = compra directa sin OC previa)
  purchaseOrderId        String?
  // NULL en históricos = saldo aún no materializado por el subledger de CxP.
  balanceDue             Decimal?  @db.Decimal(18, 4)
  paidAt                 DateTime?
  // Fecha de liquidación total; paidAt conserva por separado el hecho de pago.
  // Es nullable para no reinterpretar compras históricas.
  settledAt              DateTime?
  // Estado documental y conciliación de tres vías. Los defaults preservan las
  // compras históricas, que nacieron contabilizadas y sin matching requerido.
  documentStatus                  String    @default("POSTED") @db.VarChar(32) // POSTED | VOIDED
  matchStatus                     String    @default("NOT_REQUIRED") @db.VarChar(32) // NOT_REQUIRED | MATCHED | EXCEPTION | RESOLVED
  paymentHold                     Boolean   @default(false)
  matchResolvedBy                 String?
  matchResolvedAt                 DateTime?
  matchResolutionNote             String?   @db.Text
  matchResolutionClientEventId    String?   @db.VarChar(128)
  matchResolutionPayloadHash      String?   @db.VarChar(64)

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  supplier        Supplier                 @relation(fields: [supplierId], references: [id])
  items           PurchaseItem[]
  capitalLoan     CapitalLoan?
  serialNumbers   SerialNumber[]
  purchaseOrder   PurchaseOrder?           @relation(fields: [purchaseOrderId], references: [id])
  supplierPayments SupplierPayment[]
  matchResolver   User?                    @relation("PurchaseMatchResolver", fields: [matchResolvedBy], references: [id], onDelete: Restrict)
  matchExceptions PurchaseMatchException[]
  creditApplications SupplierCreditApplication[]

  @@index([tenantId])
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([status])
  // B1: libros de compras DGI y reportes filtran tenant+fecha de factura.
  @@index([tenantId, date])
  // Libros fiscales por régimen sin cruzar datos entre tenants.
  @@index([tenantId, fiscalRegimeAtPurchase, date])
  @@index([tenantId, supplierId, date])
  @@index([tenantId, documentStatus, postingDate])
  @@index([tenantId, matchStatus, paymentHold, date])
  @@index([matchResolvedBy])
  @@unique([tenantId, supplierId, invoiceNumber])
  @@unique([tenantId, matchResolutionClientEventId])
}

/// Subledger inmutable de pagos a proveedores. clientEventId + payloadHash
/// permiten reintentos seguros sin duplicar dinero.
model SupplierPayment {
  id            String   @id @default(cuid())
  tenantId      String
  purchaseId    String
  supplierId    String
  clientEventId String   @db.VarChar(128)
  payloadHash   String   @db.VarChar(64)
  amount        Decimal  @db.Decimal(18, 4)
  method        String   @db.VarChar(32)
  reference     String?
  notes         String?  @db.Text
  paidAt        DateTime @default(now())
  createdBy     String
  createdAt     DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  creator  User     @relation("SupplierPaymentCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([tenantId, clientEventId])
  @@index([tenantId, supplierId, paidAt])
  @@index([tenantId, purchaseId, paidAt])
  @@index([createdBy])
}

/// Salida física e inmutable de mercancía hacia el proveedor. Este documento
/// mueve inventario, pero no contabiliza la nota de crédito del proveedor.
model SupplierReturn {
  id                String   @id @default(cuid())
  tenantId          String
  supplierId        String
  returnNumber      String
  status            String   @default("POSTED") @db.VarChar(32) // POSTED
  reasonCode        String   @db.VarChar(32)
  reason            String?  @db.Text
  supplierReference String?
  clientEventId     String   @db.VarChar(128)
  payloadVersion    Int      @default(1)
  payloadHash       String   @db.VarChar(64)
  batchLedgerMode   String   @db.VarChar(16)
  returnedBy        String
  returnedAt        DateTime
  createdAt         DateTime @default(now())

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplier Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  creator  User                 @relation("SupplierReturnCreator", fields: [returnedBy], references: [id], onDelete: Restrict)
  items    SupplierReturnItem[]

  @@unique([tenantId, returnNumber])
  @@unique([tenantId, clientEventId])
  @@index([tenantId, supplierId, returnedAt])
  @@index([returnedBy])
}

/// Evidencia exacta de cada salida física. sourceType discrimina una y solo una
/// de las tres FKs de origen; el servicio valida esa unión antes de escribir.
model SupplierReturnItem {
  id                        String   @id @default(cuid())
  tenantId                  String
  supplierReturnId          String
  sourceType                String   @db.VarChar(32) // DIRECT_PURCHASE_ITEM | GOODS_RECEIPT_UNMATCHED | PURCHASE_MATCH_ALLOCATION
  purchaseItemId            String?
  goodsReceiptItemId        String?
  purchaseMatchAllocationId String?
  productId                 String
  productNameAtReturn       String   @db.VarChar(191)
  warehouseId               String
  batchId                   String?
  quantityExact             Decimal  @db.Decimal(18, 4)
  bookUnitCostExact         Decimal  @db.Decimal(18, 6)
  bookValueExact            Decimal  @db.Decimal(18, 4)
  unitAtReturn              String   @db.VarChar(32)
  saleModeAtReturn          String?  @db.VarChar(32)
  quantityStepAtReturn      Decimal? @db.Decimal(18, 4)
  batchNumberAtReturn       String?
  expiryDateAtReturn        DateTime?
  sourceHash                String   @db.VarChar(64)
  batchLedgerStatus         String   @db.VarChar(32) // NOT_APPLICABLE | APPLIED
  createdAt                 DateTime @default(now())

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplierReturn          SupplierReturn           @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)
  purchaseItem            PurchaseItem?            @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  goodsReceiptItem        GoodsReceiptItem?        @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Restrict)
  purchaseMatchAllocation PurchaseMatchAllocation? @relation(fields: [purchaseMatchAllocationId], references: [id], onDelete: Restrict)
  product                 Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse               Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  batch                   ProductBatch?            @relation(fields: [batchId], references: [id], onDelete: Restrict)
  creditNoteLine          SupplierCreditNoteLine?

  @@unique([supplierReturnId, sourceHash])
  @@index([tenantId, supplierReturnId])
  @@index([tenantId, productId, warehouseId])
  @@index([tenantId, purchaseItemId])
  @@index([tenantId, goodsReceiptItemId])
  @@index([tenantId, purchaseMatchAllocationId])
  @@index([tenantId, batchId])
}

/// Documento financiero/fiscal inmutable emitido por el proveedor. Una nota
/// puede cubrir múltiples devoluciones únicamente a través de sus líneas.
model SupplierCreditNote {
  id                         String   @id @default(cuid())
  tenantId                   String
  supplierId                 String
  creditNoteNumber           String
  type                       String   @default("RETURN") @db.VarChar(32) // RETURN
  status                     String   @default("POSTED") @db.VarChar(32) // POSTED
  invoiceDate                DateTime
  creditNoteDate             DateTime
  devolutionDate             DateTime
  postingDate                DateTime
  fiscalRegimeAtCredit       String   @db.VarChar(32)
  currencyAtIssue            String   @db.VarChar(3)
  subtotal                   Decimal  @db.Decimal(18, 4)
  tax                        Decimal  @db.Decimal(18, 4)
  creditableTax              Decimal  @db.Decimal(18, 4)
  total                      Decimal  @db.Decimal(18, 4)
  inventoryReversalExact     Decimal  @db.Decimal(18, 4)
  priceVarianceReversalExact Decimal  @db.Decimal(18, 4)
  remainingCredit            Decimal  @default(0) @db.Decimal(18, 4)
  reason                     String?  @db.Text
  supplierReference          String?
  clientEventId              String   @db.VarChar(128)
  payloadVersion             Int      @default(1)
  payloadHash                String   @db.VarChar(64)
  createdBy                  String
  createdAt                  DateTime @default(now())

  tenant       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplier     Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  creator      User                        @relation("SupplierCreditNoteCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  lines        SupplierCreditNoteLine[]
  applications SupplierCreditApplication[]

  @@unique([tenantId, supplierId, creditNoteNumber])
  @@unique([tenantId, clientEventId])
  @@index([tenantId, supplierId, creditNoteDate])
  @@index([tenantId, postingDate])
  @@index([createdBy])
}

/// Línea fiscal ligada de forma obligatoria y única a una línea física ya
/// posteada. Los snapshots permiten explicar costo, IVA y PPV sin re-derivarlos.
model SupplierCreditNoteLine {
  id                         String   @id @default(cuid())
  tenantId                   String
  creditNoteId               String
  supplierReturnItemId       String   @unique
  sourcePurchaseItemId       String?
  purchaseMatchAllocationId  String?
  sourceHash                 String   @db.VarChar(64)
  quantityExact              Decimal  @db.Decimal(18, 4)
  bookUnitCostExact          Decimal  @db.Decimal(18, 6)
  bookValueExact             Decimal  @db.Decimal(18, 4)
  subtotal                   Decimal  @db.Decimal(18, 4)
  tax                        Decimal  @db.Decimal(18, 4)
  creditableTax              Decimal  @db.Decimal(18, 4)
  total                      Decimal  @db.Decimal(18, 4)
  inventoryReversalExact     Decimal  @db.Decimal(18, 4)
  priceVarianceReversalExact Decimal  @db.Decimal(18, 4)
  descriptionAtCredit        String   @db.VarChar(191)
  unitAtCredit               String   @db.VarChar(32)
  createdAt                  DateTime @default(now())

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creditNote              SupplierCreditNote       @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  supplierReturnItem      SupplierReturnItem       @relation(fields: [supplierReturnItemId], references: [id], onDelete: Restrict)
  sourcePurchaseItem      PurchaseItem?            @relation(fields: [sourcePurchaseItemId], references: [id], onDelete: Restrict)
  purchaseMatchAllocation PurchaseMatchAllocation? @relation(fields: [purchaseMatchAllocationId], references: [id], onDelete: Restrict)

  @@unique([creditNoteId, supplierReturnItemId])
  @@index([tenantId, creditNoteId])
  @@index([tenantId, sourcePurchaseItemId])
  @@index([tenantId, purchaseMatchAllocationId])
}

/// Aplicación explícita de una nota contra una factura abierta. En v1 la suma
/// de aplicaciones debe agotar exactamente la nota al postearse.
model SupplierCreditApplication {
  id           String   @id @default(cuid())
  tenantId     String
  supplierId   String
  creditNoteId String
  purchaseId   String
  amount       Decimal  @db.Decimal(18, 4)
  createdBy    String
  appliedAt    DateTime
  createdAt    DateTime @default(now())

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplier   Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  creditNote SupplierCreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  purchase   Purchase           @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  creator    User               @relation("SupplierCreditApplicationCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([creditNoteId, purchaseId])
  @@index([tenantId, supplierId, appliedAt])
  @@index([tenantId, purchaseId, appliedAt])
  @@index([createdBy])
}

model PurchaseItem {
  id                     String    @id @default(cuid())
  purchaseId             String
  productId              String
  productName            String // Snapshot del nombre al momento de compra
  quantity               Int
  quantityExact          Decimal?  @db.Decimal(18, 4)
  unitCost               Decimal   @db.Decimal(10, 2)
  totalCost              Decimal   @db.Decimal(10, 2)
  batchNumber            String? // Número de lote ingresado en la compra
  expiryDate             DateTime? // Fecha de vencimiento ingresada en la compra
  purchaseOrderItemId    String?
  unitCostExact          Decimal?  @db.Decimal(18, 6)
  expectedUnitCostExact  Decimal?  @db.Decimal(18, 6)
  taxAmountExact         Decimal?  @db.Decimal(18, 4)
  creditableTaxExact     Decimal?  @db.Decimal(18, 4)
  priceVarianceExact     Decimal?  @db.Decimal(18, 4)
  // Evidencia exacta de la entrada física para devoluciones futuras. Nullable
  // mantiene las compras históricas ambiguas en modo fail-closed.
  inventoryWarehouseId   String?
  inventoryBatchId       String?
  inventoryUnitCostExact Decimal?  @db.Decimal(18, 6)

  purchase          Purchase                  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem?        @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  matchAllocations  PurchaseMatchAllocation[]
  matchExceptions   PurchaseMatchException[]
  inventoryWarehouse Warehouse?               @relation("PurchaseItemInventoryWarehouse", fields: [inventoryWarehouseId], references: [id], onDelete: Restrict)
  inventoryBatch     ProductBatch?            @relation("PurchaseItemInventoryBatch", fields: [inventoryBatchId], references: [id], onDelete: Restrict)
  supplierReturnItems SupplierReturnItem[]
  supplierCreditNoteLines SupplierCreditNoteLine[]

  @@index([purchaseId])
  @@index([purchaseOrderItemId])
  @@index([inventoryWarehouseId])
  @@index([inventoryBatchId])
}

// ==========================================
// ÓRDENES DE COMPRA (procurement: pedido → aprobación → recepción)
// ==========================================

model PurchaseOrder {
  id           String    @id @default(cuid())
  tenantId     String
  supplierId   String
  orderNumber  String // correlativo legible por tenant (OC-0001)
  status       String    @default("DRAFT") // DRAFT | APPROVED | PARTIALLY_RECEIVED | RECEIVED | CLOSED_SHORT | CANCELLED
  notes        String?   @db.Text
  expectedDate DateTime? // fecha esperada de entrega
  createdBy    String
  approvedBy   String? // userId que aprobó (traza, sin relación)
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
  receipts Purchase[] // recepciones (parciales o total) generadas contra esta OC
  goodsReceipts GoodsReceipt[]
  closeShorts PurchaseOrderCloseShort[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id                    String   @id @default(cuid())
  purchaseOrderId       String
  productId             String
  productName           String // snapshot del nombre al crear la OC
  quantityOrdered       Float
  quantityReceived      Float    @default(0)
  // Autoridad decimal y reglas congeladas de la OC. Los Float anteriores se
  // conservan como sombras para compatibilidad con filas/clientes históricos.
  quantityOrderedExact  Decimal? @db.Decimal(18, 4)
  quantityReceivedExact Decimal? @db.Decimal(18, 4)
  quantityRejectedExact Decimal? @db.Decimal(18, 4)
  quantityClosedShortExact Decimal? @db.Decimal(18, 4)
  unitAtOrder           String?
  saleModeAtOrder       String?
  quantityStepAtOrder   Decimal? @db.Decimal(18, 4)
  unitCost              Decimal  @db.Decimal(10, 2)
  unitCostExact         Decimal? @db.Decimal(18, 6)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  purchaseItems PurchaseItem[]
  goodsReceiptItems GoodsReceiptItem[]
  matchAllocations PurchaseMatchAllocation[]
  closeShortItems PurchaseOrderCloseShortItem[]

  @@index([purchaseOrderId])
  @@index([productId])
}

/// Comprobante físico e idempotente de recepción contra una orden de compra.
/// No contabiliza dinero: congela qué llegó, dónde y quién lo recibió.
model GoodsReceipt {
  id                  String   @id @default(cuid())
  tenantId            String
  purchaseOrderId     String
  warehouseId         String
  receiptNumber       String
  status              String   @default("POSTED") @db.VarChar(32) // POSTED
  supplierDeliveryRef String?
  clientEventId       String   @db.VarChar(128)
  payloadHash         String   @db.VarChar(64)
  payloadVersion      Int      @default(1)
  inspectionOutcome   String   @default("FULL_ACCEPT") @db.VarChar(32)
  inspectedLineCount  Int      @default(0)
  rejectedLineCount   Int      @default(0)
  hasSupplierFault    Boolean  @default(false)
  receivedBy          String
  receivedAt          DateTime @default(now())
  createdAt           DateTime @default(now())

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receiver      User               @relation("GoodsReceiptReceiver", fields: [receivedBy], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]

  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, clientEventId])
  @@index([tenantId, purchaseOrderId, receivedAt])
  @@index([tenantId, warehouseId, receivedAt])
  @@index([receivedBy])
}

/// Línea inmutable de una recepción. Los snapshots preservan unidad, costo y
/// lote aun si el catálogo o la orden cambian posteriormente.
model GoodsReceiptItem {
  id                  String   @id @default(cuid())
  tenantId            String
  goodsReceiptId      String
  purchaseOrderItemId String
  productId           String
  quantityExact       Decimal  @db.Decimal(18, 4)
  deliveredQuantityExact Decimal? @db.Decimal(18, 4)
  rejectedQuantityExact  Decimal? @db.Decimal(18, 4)
  rejectionReasonCode    String?  @db.VarChar(32)
  rejectionNotes         String?  @db.Text
  supplierFault          Boolean?
  unitSnapshot        String   @db.VarChar(32)
  saleModeSnapshot    String?  @db.VarChar(32)
  unitCostExact       Decimal  @db.Decimal(18, 6)
  batchId             String?
  batchNumber         String?
  expiryDate          DateTime?
  createdAt           DateTime @default(now())

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  receipt           GoodsReceipt              @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem         @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  product           Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch             ProductBatch?             @relation(fields: [batchId], references: [id], onDelete: Restrict)
  matchAllocations  PurchaseMatchAllocation[]
  supplierReturnItems SupplierReturnItem[]

  @@index([tenantId, goodsReceiptId])
  @@index([tenantId, purchaseOrderItemId])
  @@index([tenantId, productId])
  @@index([batchId])
}

/// Cierre inmutable e idempotente del remanente que el proveedor ya no entregará.
/// No mueve stock ni dinero; conserva el estado físico conocido al cerrar la OC.
model PurchaseOrderCloseShort {
  id                String   @id @default(cuid())
  tenantId          String
  purchaseOrderId   String
  status            String   @default("POSTED") @db.VarChar(32)
  clientEventId     String   @db.VarChar(128)
  payloadHash       String   @db.VarChar(64)
  closedBy          String
  closedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  lineCount         Int      @default(0)
  closedLineCount   Int      @default(0)
  hasSupplierFault  Boolean  @default(false)
  reasonSummaryCode String?  @db.VarChar(32)
  note              String?  @db.Text

  tenant        Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder                 @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  creator       User                          @relation("PurchaseOrderCloseShortCreator", fields: [closedBy], references: [id], onDelete: Restrict)
  items         PurchaseOrderCloseShortItem[]

  @@unique([tenantId, clientEventId])
  @@index([tenantId, purchaseOrderId, closedAt])
  @@index([closedBy])
}

/// Foto por línea del remanente cerrado. La cascada se limita al encabezado;
/// las referencias históricas a tenant y línea de OC quedan protegidas.
model PurchaseOrderCloseShortItem {
  id                            String   @id @default(cuid())
  tenantId                      String
  closeShortId                  String
  purchaseOrderItemId           String
  quantityExact                 Decimal  @db.Decimal(18, 4)
  reasonCode                    String   @db.VarChar(32)
  supplierFault                 Boolean?
  note                          String?  @db.Text
  orderedQuantitySnapshotExact  Decimal  @db.Decimal(18, 4)
  acceptedQuantitySnapshotExact Decimal  @db.Decimal(18, 4)
  rejectedQuantitySnapshotExact Decimal  @db.Decimal(18, 4)
  remainingBeforeExact          Decimal  @db.Decimal(18, 4)
  remainingAfterExact           Decimal  @db.Decimal(18, 4)
  unitSnapshot                  String   @db.VarChar(32)
  saleModeSnapshot              String?  @db.VarChar(32)
  quantityStepSnapshot          Decimal? @db.Decimal(18, 4)
  createdAt                     DateTime @default(now())

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  closeShort        PurchaseOrderCloseShort @relation(fields: [closeShortId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem       @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  @@index([tenantId, closeShortId])
  @@index([tenantId, purchaseOrderItemId])
}

/// Asignación determinista entre factura, orden y recepción. El costo esperado
/// y el real quedan congelados para explicar cualquier variación posterior.
model PurchaseMatchAllocation {
  id                    String   @id @default(cuid())
  tenantId              String
  purchaseItemId        String
  purchaseOrderItemId   String
  goodsReceiptItemId    String?
  source                String   @default("FORMAL_RECEIPT") @db.VarChar(32) // FORMAL_RECEIPT | LEGACY_PROJECTION
  quantityExact         Decimal  @db.Decimal(18, 4)
  expectedUnitCostExact Decimal  @db.Decimal(18, 6)
  actualUnitCostExact   Decimal  @db.Decimal(18, 6)
  priceVarianceExact    Decimal  @db.Decimal(18, 4)
  createdAt             DateTime @default(now())

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseItem      PurchaseItem      @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  goodsReceiptItem  GoodsReceiptItem? @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Restrict)
  supplierReturnItems SupplierReturnItem[]
  supplierCreditNoteLines SupplierCreditNoteLine[]

  @@unique([purchaseItemId, goodsReceiptItemId])
  @@index([tenantId, purchaseItemId])
  @@index([tenantId, purchaseOrderItemId])
  @@index([tenantId, goodsReceiptItemId])
}

/// Excepción persistente del matching. La resolución nunca borra el hallazgo:
/// conserva valores comparados, tolerancia, motivo y autor.
model PurchaseMatchException {
  id                 String    @id @default(cuid())
  tenantId           String
  purchaseId         String
  purchaseItemId     String?
  type               String    @db.VarChar(32)
  status             String    @default("OPEN") @db.VarChar(16) // OPEN | RESOLVED
  expectedValueExact Decimal?  @db.Decimal(18, 6)
  actualValueExact   Decimal?  @db.Decimal(18, 6)
  varianceExact      Decimal?  @db.Decimal(18, 6)
  toleranceExact     Decimal?  @db.Decimal(18, 6)
  resolutionNote     String?   @db.Text
  resolvedBy         String?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchase     Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseItem PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade)
  resolver     User?         @relation("PurchaseMatchExceptionResolver", fields: [resolvedBy], references: [id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, purchaseId, status])
  @@index([purchaseItemId])
  @@index([resolvedBy])
}

/// Política por tenant para matching de precio y retención automática de pago.
model ProcurementPolicy {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  priceTolerancePct Decimal  @default(0) @db.Decimal(9, 4)
  autoHold          Boolean  @default(true)
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  updater User?  @relation("ProcurementPolicyUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([updatedBy])
}

model Employee {
  id                    String   @id @default(cuid())
  tenantId              String
  userId                String?  @unique // Link a User (para el EmployeeProfile real interactivo)
  firstName             String
  lastName              String
  role                  String
  pin                   String   @default("0000")
  cedula                String? // Cédula de identidad nicaragüense
  inss                  String? // Número INSS del empleado
  baseSalary            Decimal  @db.Decimal(10, 2)
  commissionRate        Decimal  @default(0) @db.Decimal(5, 2)
  phone                 String?
  vacationDays          Float    @default(0) // Días de vacaciones acumulados
  accumulatedThirteenth Decimal  @default(0) @db.Decimal(10, 2) // Aguinaldo acumulado
  hireDate              DateTime @default(now())
  bankAccount           String?
  status                String   @default("ACTIVE") // ACTIVE, SUSPENDED, TERMINATED
  jornada               String   @default("DIURNA") // DIURNA 8h | NOCTURNA 7h | MIXTA 7.5h (Art. 51)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  sales    Sale[]
  shifts   Shift[]
  payrolls Payroll[]

  // HR Relations
  leaveRequests         LeaveRequest[]
  salaryAdvances        SalaryAdvance[]
  terminationSettlement TerminationSettlement?
  payrollLines          PayrollLine[]
  aguinaldos            Aguinaldo[]
  contracts             EmploymentContract[]
  judicialDeductions    JudicialDeduction[]

  @@index([tenantId])
}

// Deducción judicial recurrente — pensión alimenticia / embargo (Art. 88 Ley
// 185; tienen prioridad legal sobre otras deducciones). Monto fijo o % del
// salario disponible (neto de deducciones de ley).
model JudicialDeduction {
  id          String    @id @default(cuid())
  tenantId    String
  employeeId  String
  type        String // PENSION_ALIMENTICIA | EMBARGO | OTRO
  amount      Decimal?  @db.Decimal(10, 2) // monto fijo (alternativa a percentage)
  percentage  Float? // % del salario disponible (alternativa a amount)
  beneficiary String? // a quién se paga / N° de expediente judicial
  priority    Int       @default(1) // menor = mayor prioridad (pensión = 1)
  status      String    @default("ACTIVE") // ACTIVE | ENDED
  startDate   DateTime  @default(now())
  endDate     DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
}

// Calendario de feriados (Art. 66 Ley 185). Los nacionales se siembran por
// tenant/año; el negocio puede agregar fiestas locales (national = false).
model Holiday {
  id        String   @id @default(cuid())
  tenantId  String
  date      DateTime @db.Date
  name      String
  national  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, date])
  @@index([tenantId])
}

// Expediente digital — contrato de trabajo (Art. 19-28 Ley 185; el MITRAB
// exige contrato escrito). Un empleado puede tener varios (renovaciones).
model EmploymentContract {
  id           String    @id @default(cuid())
  tenantId     String
  employeeId   String
  type         String // INDETERMINADO | DETERMINADO | POR_OBRA
  startDate    DateTime
  endDate      DateTime? // para DETERMINADO / POR_OBRA
  probationEnd DateTime? // fin del período de prueba (hasta 30 días, Art. 28)
  salary       Decimal   @db.Decimal(10, 2)
  position     String? // cargo
  notes        String?   @db.Text
  status       String    @default("ACTIVE") // ACTIVE | ENDED
  createdBy    String
  createdAt    DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
}

// Corrida de aguinaldo (treceavo mes) — Art. 93-95 Ley 185.
// Una fila por empleado y año de corrida (período dic[year-1] → nov[year]).
model Aguinaldo {
  id            String   @id @default(cuid())
  tenantId      String
  employeeId    String
  year          Int
  diasLaborados Int
  baseSalary    Decimal  @db.Decimal(10, 2)
  monto         Decimal  @db.Decimal(10, 2)
  status        String   @default("PAGADO")
  paidAt        DateTime @default(now())
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, year])
  @@index([tenantId])
}

// ==========================================
// NÓMINA NICARAGÜENSE (LEY 185 CÓDIGO DEL TRABAJO)
// ==========================================

model Payroll {
  id         String @id @default(cuid())
  tenantId   String
  employeeId String
  month      Int // 1-12
  year       Int

  // Ingresos
  grossSalary Decimal @db.Decimal(10, 2) // Salario Base
  commissions Decimal @default(0) @db.Decimal(10, 2)
  totalIncome Decimal @db.Decimal(10, 2) // Bruto total

  // Deducciones de Ley
  inssLaboral     Decimal @db.Decimal(10, 2) // 7% (INSS Laboral)
  irLaboral       Decimal @db.Decimal(10, 2) // IR según tabla progresiva DGI
  totalDeductions Decimal @db.Decimal(10, 2)

  // Neto
  netSalary Decimal @db.Decimal(10, 2) // Neto a recibir

  // Aportes Patronales (costo empresa)
  inssPatronal Decimal @db.Decimal(10, 2) // 22.5% (INSS Patronal)
  inatec       Decimal @db.Decimal(10, 2) // 2% (INATEC)

  // Fase A RRHH: horas extra (Art. 62 Ley 185, al doble) y descuento de adelantos
  overtimePay      Decimal @default(0) @db.Decimal(10, 2)
  horasExtra       Float   @default(0)
  advanceDeduction Decimal @default(0) @db.Decimal(10, 2)

  // Fase C2: feriados trabajados (Art. 68, recargo del 100% por día)
  holidayPay   Decimal @default(0) @db.Decimal(10, 2)
  diasFeriados Float   @default(0)

  // Fase A p2: ausencias sin goce de salario (descuentan días trabajados)
  absenceDeduction Decimal @default(0) @db.Decimal(10, 2)
  diasAusencia     Float   @default(0)

  // Fase C4: deducciones judiciales (pensión alimenticia / embargos)
  judicialDeduction Decimal @default(0) @db.Decimal(10, 2)

  status    String    @default("PENDIENTE") // PENDIENTE | PAGADO
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  employee         Employee        @relation(fields: [employeeId], references: [id])
  advancesDeducted SalaryAdvance[]

  @@unique([employeeId, month, year])
  @@index([tenantId])
  @@index([employeeId])
}

// ==========================================
// REPORTES FISCALES DGI NICARAGUA
// ==========================================

model TaxReport {
  id       String @id @default(cuid())
  tenantId String
  month    Int
  year     Int

  // Ventas
  totalSales        Decimal @db.Decimal(12, 2)
  totalIVACollected Decimal @db.Decimal(12, 2) // IVA cobrado en ventas
  totalIVAPaid      Decimal @db.Decimal(12, 2) // IVA pagado en compras (crédito fiscal)

  // Impuestos a pagar
  ivaNeto     Decimal @db.Decimal(12, 2) // IVA Ventas - IVA Compras
  anticipoIR  Decimal @db.Decimal(12, 2) // 1% sobre ventas netas
  imiAlcaldia Decimal @db.Decimal(12, 2) // 1% impuesto municipal
  totalToPay  Decimal @db.Decimal(12, 2)

  generatedAt DateTime @default(now())

  @@unique([tenantId, month, year])
  @@index([tenantId])
}

model Sale {
  id                        String    @id @default(cuid())
  tenantId                  String
  total                     Decimal   @db.Decimal(18, 4)
  // T2 — porción del total que corresponde a productos EXONERADOS de IVA.
  // NULLABLE a propósito (backfill perezoso): `null` = venta anterior a T2 →
  // se trata como 100% GRAVADA, exactamente el comportamiento histórico. Solo
  // las ventas nuevas escriben un valor (0 cuando todo es gravado).
  exemptTotal               Decimal?  @db.Decimal(18, 4)
  // Foto inmutable del régimen aplicado. GENERAL/1 preserva el comportamiento
  // de ventas históricas; IVA NULL significa que el monto no quedó persistido.
  fiscalRegimeAtSale        String    @default("GENERAL") @db.VarChar(32)
  fiscalRegimeVersionAtSale Int       @default(1)
  vatAmountAtSale           Decimal?  @db.Decimal(18, 4)
  status                    String
  paymentMethod             String
  customerName              String?
  customerId                String?
  employeeId                String?
  balance                   Decimal   @default(0) @db.Decimal(10, 2)
  storeCreditApplied        Decimal   @default(0) @db.Decimal(18, 4)
  dueDate                   DateTime?
  shiftId                   String?
  // Vendedores (cartera de ruta): QUIÉN vendió, tomado SIEMPRE de req.userId
  // (JWT) server-side. Nullable a propósito: (a) aditivo para db push, (b) las
  // filas históricas quedan null = "Sin vendedor" — NO backfillear desde
  // Shift.userId, que es mutable (POST /api/shifts/:id/tomar reasigna el turno
  // sin cerrarlo y re-atribuiría lo ya vendido al último dueño de la caja); la
  // fuente honesta de backfill es KardexMovement.userId (Fase B, opcional).
  // No confundir con employeeId (Employee de RRHH por PIN = quién tiene la
  // gaveta) ni con shiftId (la caja): esto es la persona que FACTURÓ.
  soldById                  String?
  createdAt                 DateTime  @default(now())
  globalDiscount            Float     @default(0)
  // Facturación DGI
  invoiceNumber             Int? // Consecutivo controlado (1, 2, 3...)
  invoiceSeries             String? // Serie: "A", "B" (por sucursal)
  // PWA Offline Sync — UUID generado en el cliente para idempotencia
  offlineId                 String?   @unique
  // Hash canónico del payload offline. Nullable solo para ventas históricas;
  // permite distinguir un replay real de la reutilización conflictiva del ID.
  offlinePayloadHash        String?   @db.VarChar(64)

  // ── ANULACIÓN FISCAL (DGI-5, Disposición Técnica 09-2007) ──────────────────
  // Una factura mal emitida NO se borra ni se edita: se ANULA, y el comprobante
  // anulado sigue existiendo, visible y marcado como tal. Su número NO se
  // reutiliza — un correlativo con huecos o repetidos es justo lo que la norma
  // prohíbe. Todos nullable: aditivo para `db push`, y `null` = venta vigente,
  // que es el comportamiento histórico de las filas existentes.
  //
  // Distinto de una DEVOLUCIÓN (ProductReturn): devolver mercadería es una
  // operación nueva sobre una venta que SÍ ocurrió; anular es declarar que el
  // documento no debió emitirse.
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?   @db.Text

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  customer       Customer?       @relation(fields: [customerId], references: [id])
  employee       Employee?       @relation(fields: [employeeId], references: [id])
  shift          Shift?          @relation(fields: [shiftId], references: [id])
  soldBy         User?           @relation("SaleSeller", fields: [soldById], references: [id])
  cancelledBy    User?           @relation("SaleCanceller", fields: [cancelledById], references: [id])
  items          SaleItem[]
  payments       Payment[]
  productReturns ProductReturn[]
  correctionRequests SaleCorrectionRequest[]
  returnRefunds      ReturnRefund[]
  customerCreditEntries CustomerCreditEntry[]
  serialNumbers  SerialNumber[]
  pedidos        Pedido[]

  @@index([tenantId])
  @@index([customerId])
  @@index([employeeId])
  @@index([shiftId])
  @@index([tenantId, createdAt])
  // Reporte "cuánto vende cada vendedor": groupBy(soldById) filtrado por
  // tenant y rango de fechas. Índice compuesto en el MISMO cambio que la query.
  @@index([tenantId, soldById, createdAt])
  // Anulación (DGI-5): TODOS los reportes de dinero ahora filtran por
  // `status != 'VOIDED'` junto al tenant. Sin este índice esa exclusión obliga
  // a recorrer la tabla de ventas entera — el guardrail 3 pide el índice en el
  // MISMO cambio que la query.
  @@index([tenantId, status])
  // Reporte íntegro por período y cierre por turno: el filtro siempre combina
  // tenant + estado vigente con fecha o shift, no índices aislados.
  @@index([tenantId, status, createdAt])
  @@index([tenantId, shiftId, status])
  // Reportes/libros por régimen y período, siempre aislados por tenant.
  @@index([tenantId, fiscalRegimeAtSale, createdAt])
}

model SaleItem {
  id                         String   @id @default(cuid())
  saleId                     String
  productId                  String
  quantity                   Float
  priceAtSale                Decimal  @db.Decimal(10, 2)
  // Precio unitario autoritativo antes de redondear a centavos. Permite que
  // presentaciones como C$10 / 3 unidades totalicen C$10.00 y se devuelvan
  // con el mismo valor histórico; priceAtSale queda como shadow legado.
  unitPriceExactAtSale       Decimal? @db.Decimal(18, 4)
  costAtSale                 Decimal  @db.Decimal(10, 2)
  discount                   Float    @default(0) // Item discount percentage (0-100)
  productNameAtSale          String?
  unitAtSale                 String?
  saleModeAtSale             String?
  quantityStepAtSale         Decimal? @db.Decimal(18, 4)
  presentationAtSale         String? // BASE | PACK
  presentationQuantityAtSale Decimal? @db.Decimal(18, 4)
  // T2: foto del trato fiscal AL MOMENTO de vender (igual que costAtSale).
  // Si el dueño reclasifica el producto después, las ventas viejas no cambian.
  ivaExento                  Boolean  @default(false)

  sale             Sale                      @relation(fields: [saleId], references: [id])
  measurement      SaleMeasurement?
  batchAllocations SaleItemBatchAllocation[]
  correctionLines SaleCorrectionLine[]
  productReturnItems ProductReturnItem[]

  @@index([saleId])
}

// Capacidades opt-in: un tenant puede combinar carnes, alimento animal y otros
// giros sin convertir Tenant.type en una clasificación mutuamente excluyente.
model TenantCapability {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, createdAt])
}

// Identidad estable del formato de etiqueta. Las reglas de parseo viven en
// versiones inmutables para que las ventas offline sean reproducibles.
model ScaleLabelProfile {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  status    String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  versions ScaleLabelProfileVersion[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model ScaleLabelProfileVersion {
  id                String    @id @default(cuid())
  tenantId          String
  profileId         String
  version           Int
  status            String    @default("DRAFT") // DRAFT | PUBLISHED | REVOKED
  symbology         String
  totalLength       Int
  prefixes          Json
  itemStart         Int
  itemLength        Int
  valueStart        Int
  valueLength       Int
  valueKind         String // WEIGHT | TOTAL_PRICE | COUNT
  impliedDecimals   Int
  sourceUnit        String
  checksumMode      String
  pricePolicy       String // RECALCULATE | REQUIRE_MATCH | ACCEPT_LABEL_TOTAL
  roundingTolerance Decimal   @db.Decimal(18, 4)
  minValue          Decimal   @db.Decimal(18, 4)
  maxValue          Decimal   @db.Decimal(18, 4)
  publishedAt       DateTime?
  revokedAt         DateTime?
  createdBy         String
  createdAt         DateTime  @default(now())

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  profile      ScaleLabelProfile     @relation(fields: [profileId], references: [id], onDelete: Restrict)
  creator      User                  @relation("ScaleLabelProfileVersionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  mappings     ScaleProductMapping[]
  measurements SaleMeasurement[]

  @@unique([tenantId, profileId, version])
  @@index([profileId])
  @@index([createdBy])
  @@index([tenantId, status, createdAt])
}

model ScaleProductMapping {
  id               String   @id @default(cuid())
  tenantId         String
  profileVersionId String
  plu              String
  productId        String
  sourceUnit       String
  createdAt        DateTime @default(now())

  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  profileVersion ScaleLabelProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Restrict)
  product        Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([tenantId, profileVersionId, plu])
  @@index([profileVersionId])
  @@index([tenantId, productId])
}

model ScaleDevice {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  manufacturer   String?
  model          String?
  transport      String
  protocolKey    String
  adapterVersion String
  status         String    @default("ACTIVE") // ACTIVE | INACTIVE | UNSUPPORTED
  config         Json?
  createdBy      String
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creator      User              @relation("ScaleDeviceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  measurements SaleMeasurement[]

  @@index([createdBy])
  @@index([tenantId, status])
  @@index([tenantId, transport])
}

// Evidencia auditable de una etiqueta o lectura en vivo. Es uno-a-uno con la
// línea de venta; precio, impuesto y stock siguen siendo autoritativos server-side.
model SaleMeasurement {
  id               String   @id @default(cuid())
  tenantId         String
  saleItemId       String   @unique
  source           String // SCALE_LABEL | LIVE_SCALE
  profileVersionId String?
  deviceId         String?
  sourceValue      Decimal  @db.Decimal(18, 4)
  sourceUnit       String
  baseQuantity     Decimal  @db.Decimal(18, 4)
  encodedPrice     Decimal? @db.Decimal(18, 4)
  pricingPolicy    String // RECALCULATE | REQUIRE_MATCH | ACCEPT_LABEL_TOTAL
  stable           Boolean?
  clientEventId    String
  payloadHash      String?
  capturedAt       DateTime
  createdAt        DateTime @default(now())
  userId           String

  tenant         Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  saleItem       SaleItem                  @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  profileVersion ScaleLabelProfileVersion? @relation(fields: [profileVersionId], references: [id], onDelete: Restrict)
  device         ScaleDevice?              @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  user           User                      @relation("SaleMeasurementUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, clientEventId])
  @@index([profileVersionId])
  @@index([deviceId])
  @@index([userId])
  @@index([tenantId, capturedAt])
  @@index([tenantId, source, capturedAt])
}

model SaleItemBatchAllocation {
  id         String   @id @default(cuid())
  tenantId   String
  saleItemId String
  batchId    String
  warehouseId String?
  quantity   Decimal  @db.Decimal(18, 4)
  createdAt  DateTime @default(now())

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  saleItem SaleItem     @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  batch    ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  warehouse Warehouse?  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([saleItemId, batchId])
  @@index([tenantId, saleItemId])
  @@index([tenantId, batchId])
  @@index([tenantId, warehouseId])
}

model Payment {
  id            String   @id @default(cuid())
  saleId        String
  amount        Decimal  @db.Decimal(10, 2)
  method        String
  collectedBy   String
  // Opcional por compatibilidad histórica. Clientes nuevos lo envían y el
  // índice evita cobrar dos veces ante retry/doble clic.
  clientEventId String?  @db.VarChar(128)
  payloadHash   String?  @db.VarChar(64)
  createdAt     DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])
  user User @relation(fields: [collectedBy], references: [id])

  @@unique([saleId, clientEventId])
  @@index([saleId])
  // B1: el agregado de cobros del día recorre pagos por fecha (el tenant
  // viene por el join a Sale, que ya tiene su compuesto).
  @@index([createdAt])
  // Reporte "cuánto cobra cada vendedor": groupBy(collectedBy) por rango de
  // fechas. Payment NO tiene tenantId — el scoping viene del join a Sale.
  @@index([collectedBy, createdAt])
}

model Shift {
  id                   String    @id @default(cuid())
  tenantId             String
  userId               String
  employeeId           String? // Empleado que abrió la caja (PIN)
  initialCash          Decimal   @db.Decimal(10, 2)
  finalCashDeclared    Decimal?  @db.Decimal(10, 2)
  systemExpectedCash   Decimal?  @db.Decimal(10, 2)
  difference           Decimal?  @db.Decimal(10, 2)
  // Gaveta multi-moneda (Fase D agente bancario): conteo físico de DÓLARES
  // separado del de córdobas. Los campos NIO de arriba quedan intactos.
  initialCashUsd       Decimal   @default(0) @db.Decimal(18, 4)
  finalCashDeclaredUsd Decimal?  @db.Decimal(18, 4)
  systemExpectedUsd    Decimal?  @db.Decimal(18, 4)
  differenceUsd        Decimal?  @db.Decimal(18, 4)
  regularHours         Float     @default(0)
  overtimeHours        Float     @default(0)
  nightHours           Float     @default(0)
  status               String
  startTime            DateTime  @default(now())
  endTime              DateTime?
  // Idempotencia del adaptador legado de cierre. Los historicos quedan NULL.
  closeEventId         String?   @db.VarChar(128)
  closePayloadHash     String?   @db.VarChar(64)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  employee      Employee?      @relation(fields: [employeeId], references: [id])
  sales         Sale[]
  cashMovements CashMovement[]
  closeReport   ShiftCloseReport?
  processedReturns ProductReturn[] @relation("ProcessedShiftReturns")
  RouteExpense  RouteExpense[]

  @@index([tenantId])
  @@index([tenantId, status, startTime])
  @@index([userId])
  @@index([employeeId])
  @@unique([tenantId, closeEventId])
}

// Snapshot Z inmutable generado atómicamente al cerrar una caja. `report`
// conserva los totales y desgloses exactos de la versión que fue emitida.
model ShiftCloseReport {
  id           String   @id @default(cuid())
  tenantId     String
  shiftId      String   @unique
  folio        String
  businessDate String   @db.VarChar(10)
  version      Int      @default(1)
  report       Json
  contentHash  String   @db.VarChar(64)
  createdBy    String
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  shift  Shift  @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([tenantId, folio])
  @@index([tenantId, businessDate])
  @@index([tenantId, createdAt])
}

model Expense {
  id          String   @id @default(cuid())
  tenantId    String
  amount      Decimal  @db.Decimal(12, 2)
  description String   @db.Text
  category    String
  createdAt   DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  cashMovement CashMovement?

  @@index([tenantId])
  @@index([category])
  // B1: reportes de gastos por período filtran tenant+fecha.
  @@index([tenantId, createdAt])
}

// ==========================================
// 💰 CASH MOVEMENTS (ENTRADAS/SALIDAS DE CAJA)
// ==========================================

model CashMovement {
  id          String    @id @default(cuid())
  tenantId    String
  shiftId     String
  userId      String
  type        String // IN | OUT
  amount      Decimal   @db.Decimal(10, 2)
  currency    String    @default("NIO") // NIO | USD
  category    String // GASTO_OPERATIVO | PAGO_PROVEEDOR | RETIRO_PERSONAL | CAMBIO | INYECCION_CAPITAL | AJUSTE
  description String    @db.Text
  expenseId   String?   @unique // Auto-linked Expense (for OUT movements)
  isVoided    Boolean   @default(false) // Soft delete: movimiento anulado
  voidReason  String?   @db.Text
  voidedAt    DateTime?
  voidedBy    String?
  createdAt   DateTime  @default(now())

  // Integridad del libro (tamper-evidence) — cadena de hash por tenant.
  // Nullable: filas legacy quedan sin firmar hasta el backfill.
  // La anulación (isVoided/voidReason/...) NO entra en la firma: el registro
  // económico es inmutable; el void es una anotación posterior.
  seq       Int? // Posición monotónica en la cadena del tenant
  prevHash  String? // Firma del movimiento anterior (encadenamiento)
  signature String? // HMAC-SHA256 de los campos inmutables (versionado "vN:...")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  shift   Shift    @relation(fields: [shiftId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  expense Expense? @relation(fields: [expenseId], references: [id])

  @@unique([tenantId, seq])
  @@index([tenantId])
  @@index([shiftId])
  @@index([createdAt])
  @@index([tenantId, shiftId, isVoided])
}

// Cabeza de la cadena del libro por tenant. El UPDATE con increment toma
// row-lock de InnoDB → serializa los appends del tenant (sin carreras de seq).
model LedgerHead {
  tenantId  String   @id
  lastSeq   Int      @default(0)
  lastHash  String   @default("GENESIS")
  updatedAt DateTime @updatedAt
}

// ==========================================
// 🏦 AGENTE BANCARIO (corresponsalía no bancaria)
// El negocio opera como Agente Banpro / Rapibac / ServiRED / Puntoxpress, etc.
// Nortex registra en paralelo lo que pasa por el dispositivo del banco para
// cuadrar la caja (shadow ledger): cada operación genera un CashMovement
// firmado (category AGENTE_BANCARIO) + una AgentTransaction con el detalle.
// tenantId como escalar (sin relación) para no tocar el bloque de relaciones
// de Tenant (mismo patrón que WhatsApp); el aislamiento se aplica por query.
// Ver docs/PLAN_AGENTE_BANCARIO.md.
// ==========================================

model AgentAgreement {
  id       String  @id @default(cuid())
  tenantId String
  name     String // "Agente Banpro", "Rapibac", "Puntoxpress"...
  kind     String  @default("BANCO") // BANCO | RED_RECAUDADORA | REMESERA
  active   Boolean @default(true)

  // Comisiones por tipo de operación, pactadas en el contrato (no son públicas
  // en Nicaragua → SIEMPRE configurables): { "DEPOSITO": {"fija": 5, "pct": 0}, ... }
  commissionConfig Json?

  // Límites por operación (Fase C), también del contrato — p. ej. Banpro
  // publica retiros máx US$3,000 y 3 depósitos/día, pero cada convenio pacta
  // lo suyo: { "RETIRO": {"maxTx": 10000, "maxDia": 50000}, ... }
  limitsConfig Json?

  // Saldos espejo del convenio (proyección, se actualiza en la misma tx que
  // cada operación — patrón Motorizado.walletBalance):
  // settlementBalance: cuánto le DEBE el negocio al banco por efectivo captado
  // (+ con depósitos/pagos; − con retiros/remesas pagadas = el banco nos debe).
  settlementBalance Decimal @default(0) @db.Decimal(18, 4)
  // Comisiones devengadas aún no liquidadas por el banco (ingreso por cobrar).
  commissionAccrued Decimal @default(0) @db.Decimal(18, 4)

  createdAt DateTime @default(now())

  transactions AgentTransaction[]

  @@index([tenantId])
}

model AgentTransaction {
  id             String @id @default(cuid())
  tenantId       String
  agreementId    String
  // 1:1 con el movimiento de caja firmado que la respalda (libro encadenado).
  cashMovementId String @unique
  shiftId        String
  userId         String

  // DEPOSITO | RETIRO | PAGO_TARJETA | PAGO_PRESTAMO | PAGO_SERVICIO |
  // RECARGA | REMESA_ENVIO | REMESA_COBRO
  operation    String
  direction    String // IN | OUT (espejo del CashMovement.type)
  amount       Decimal  @db.Decimal(18, 4)
  currency     String   @default("NIO") // NIO | USD
  // Multi-moneda (Fase D): tipo de cambio de la transacción (solo USD) y
  // valor contable en córdobas (USD: amount×rate; NIO: = amount). La
  // contabilidad, el settlementBalance y los límites diarios usan amountNio.
  exchangeRate Decimal? @db.Decimal(12, 6)
  amountNio    Decimal? @db.Decimal(18, 4)
  // Comisión devengada en C$ (NO es efectivo: el banco la liquida después a cuenta).
  commission   Decimal  @default(0) @db.Decimal(18, 4)

  // Folio/voucher del dispositivo del banco — el comprobante válido y la
  // clave de conciliación contra el reporte del banco/red.
  externalRef String?
  customerRef String? // referencia opcional del cliente (nombre/teléfono)

  status     String    @default("COMPLETED") // COMPLETED | REVERSED (Fase B)
  reversedAt DateTime?
  reversedBy String?
  createdAt  DateTime  @default(now())

  agreement AgentAgreement @relation(fields: [agreementId], references: [id])

  @@index([tenantId, createdAt])
  @@index([agreementId, createdAt])
  @@index([shiftId])
}

// ==========================================
// WHATSAPP — Agente IA (RAG) · infraestructura Fase 1
// tenantId como escalar (sin relación) para no tocar el bloque de
// relaciones de Tenant; el aislamiento se aplica en la capa de servicio.
// ==========================================

// Mapea un número de WhatsApp (phone_number_id de Meta) → tenant.
// Un solo Meta App de plataforma (WHATSAPP_APP_SECRET global verifica la
// firma de TODO webhook); cada tenant trae su número/WABA y su access token
// de envío (cifrado con crypto.encryptField).
model WhatsAppChannel {
  id             String   @id @default(cuid())
  tenantId       String
  phoneNumberId  String   @unique // ID del número en Meta — routing de entrada
  wabaId         String? // WhatsApp Business Account
  displayPhone   String? // +505… legible
  accessTokenEnc String   @db.Text // token de envío, CIFRADO (enc:v1:…)
  botScope       String   @default("B2C") // B2C | B2B | BOTH
  defaultMode    String   @default("BOT") // BOT | HUMAN
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([tenantId])
}

// Una conversación por (tenant, waId). Mantiene el estado de handoff.
model WhatsAppConversation {
  id             String    @id @default(cuid())
  tenantId       String
  waId           String // número del cliente final (E.164 sin +)
  customerId     String? // resuelto contra Customer (null = onboarding pendiente)
  status         String    @default("BOT") // BOT | HUMAN | CLOSED
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  messages WhatsAppMessage[]

  @@unique([tenantId, waId])
  @@index([tenantId, status])
}

model WhatsAppMessage {
  id             String   @id @default(cuid())
  conversationId String
  tenantId       String
  direction      String // IN | OUT
  waMessageId    String?  @unique // id de Meta — idempotencia de entrada
  type           String   @default("text")
  body           String   @db.Text
  status         String? // sent | delivered | read | failed (salientes)
  createdAt      DateTime @default(now())

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId])
}

model B2BOrder {
  id        String   @id @default(cuid())
  tenantId  String
  total     Decimal  @db.Decimal(18, 4)
  items     Json
  status    String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  // B1: la tabla que más rápido crece (1 fila por venta/ajuste/pago/cierre);
  // la bitácora y los filtros por acción necesitan tenant+fecha.
  @@index([tenantId, createdAt])
  @@index([tenantId, action, createdAt])
}

// ==========================================
// INVENTORY MANAGEMENT (Professional Kardex System)
// ==========================================

model Product {
  id       String @id @default(cuid())
  tenantId String

  // Identificación
  name        String
  sku         String // Código único del producto
  description String? @db.Text
  category    String?

  // Precios
  price           Float // Precio de venta (detalle)
  cost            Float // Costo de compra
  // Venta por mayor (distribuidora/miscelánea): precio de mayoreo y cantidad
  // mínima a partir de la cual aplica. Float para calzar con price/cost — los
  // tres migran juntos a Decimal(18,4) en el sweep de precisión pendiente.
  wholesalePrice  Float? // Precio de mayoreo (null = producto sin mayoreo)
  wholesaleMinQty Float? // Cantidad mínima para mayoreo (ej: 12 = docena)
  // Unidad de empaque (Fase B): "caja de 12 a C$90". El POS vende el empaque
  // como atajo de cantidad (unidades base) y packPrice actúa como tercer nivel
  // de precio a partir de packSize. El stock/Kardex siguen en unidades base.
  packUnit        String? // nombre del empaque (caja, fardo, docena)
  packSize        Float? // unidades base por empaque (ej: 12)
  packPrice       Float? // precio del empaque completo (null = solo atajo de cantidad)
  saleMode        String? // COUNTED | MEASURED; null = producto legado
  quantityStep    Decimal? @db.Decimal(18, 4)
  productFamily   String? // GENERAL | MEAT | POULTRY | ANIMAL_FEED | AGRO_INPUT | VETERINARY

  // Inventario
  stock    Float  @default(0)
  minStock Float  @default(0) // Stock mínimo para alerta
  unit     String @default("unidad") // kg, litro, unidad, caja, etc.

  // Reposición (Bodeguero B2)
  reorderPoint Float @default(0) // Punto de reorden: stock ≤ esto → reponer
  maxStock     Float @default(0) // Stock objetivo/máximo (para sugerir cuánto comprar)

  // Proveedor por defecto (Bodeguero C2) — agrupa/prellena la orden de compra
  defaultSupplierId String?

  // Catálogo Público
  isPublished Boolean @default(false) // Visible en catálogo público

  // T2 — IVA: exoneración por producto. Nicaragua exonera canasta básica y
  // medicamentos (LCT 822 art. 127). Default false = GRAVADO, que es el
  // comportamiento histórico: ningún producto existente cambia de trato.
  // La clasificación legal la hace el dueño del negocio, no el sistema.
  ivaExento Boolean @default(false)
  imageUrl  String? // URL de imagen del producto

  // Control de Lotes
  requiresBatchTracking  Boolean @default(false)
  // Control de Series (números de serie / IMEI / VIN, por unidad)
  requiresSerialTracking Boolean @default(false)

  // Auditoría
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  // Relaciones
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator              User                  @relation(fields: [createdBy], references: [id])
  kardexMovements      KardexMovement[]
  pedidoItems          PedidoItem[]
  batches              ProductBatch[]
  stockCountItems      StockCountItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  serialNumbers        SerialNumber[]
  productStocks        ProductStock[]
  sellerCatalog        SellerProduct[]
  defaultSupplier      Supplier?             @relation("DefaultSupplier", fields: [defaultSupplierId], references: [id], onDelete: SetNull)
  scaleProductMappings ScaleProductMapping[]
  batchWarehouseStocks ProductBatchWarehouseStock[]
  batchLedgerEntries   ProductBatchLedgerEntry[]
  supplierReturnItems  SupplierReturnItem[]
  returnInspections    ReturnInspection[]
  productReturnItems   ProductReturnItem[]

  @@unique([tenantId, sku])
  @@index([defaultSupplierId])
  @@index([tenantId])
  @@index([tenantId, isPublished, name])
  @@index([tenantId, isPublished, category, name])
  @@index([category])
  @@fulltext([name, category])
}

model KardexMovement {
  id       String @id @default(cuid())
  tenantId String

  // Producto afectado
  productId String

  // Tipo de movimiento
  type     String // IN (entrada), OUT (salida), SALE (venta), ADJUSTMENT (ajuste), RETURN (devolución)
  quantity Float // Cantidad (positiva para entradas, negativa para salidas)

  // Stock antes/después para auditoría
  stockBefore Float
  stockAfter  Float

  // Referencia opcional (ID de venta, compra, etc.)
  referenceId   String?
  referenceType String? // SALE, PURCHASE, ADJUSTMENT, INITIAL

  // Auditoría
  reason String?  @db.Text
  date   DateTime @default(now())
  userId String

  // Relaciones
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id])
  batchId     String?
  batch       ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  // Bodega del movimiento (null = anterior a multi-bodega / no especificada)
  warehouseId String?
  warehouse   Warehouse?    @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([tenantId])
  @@index([date])
  @@index([type])
  @@index([batchId])
  @@index([warehouseId])
  // B1: el Kardex se consulta por tenant+tipo+fecha (mermas, reportes) y por
  // tenant+producto+fecha (historial de un producto) — compuestos dedicados.
  @@index([tenantId, type, date])
  @@index([tenantId, productId, date])
}

// ==========================================
// MULTI-BODEGA (Fase 2: fundación)
// Product.stock sigue siendo el AGREGADO autoritativo (Σ bodegas); ProductStock
// es el desglose por bodega. El backfill es perezoso: la bodega default absorbe
// el total legado la primera vez que se toca (ver stockService).
// ==========================================

// Vendedores Fase B — catálogo asignado: qué productos vende cada vendedor.
// OPT-IN por vendedor: sin filas acá, el vendedor ve el catálogo COMPLETO
// (comportamiento de siempre); con una o más filas, su POS solo lista estas.
// Independiente de la carga física (Warehouse.sellerId): un negocio puede usar
// una, la otra, ambas o ninguna.
model SellerProduct {
  id        String   @id @default(cuid())
  tenantId  String
  sellerId  String
  productId String
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  seller  User    @relation("SellerCatalog", fields: [sellerId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([tenantId, sellerId, productId])
  // El filtro del POS busca por vendedor; el índice del unique ya lo cubre
  // (prefijo tenantId+sellerId). Este segundo sirve el borrado por producto.
  @@index([tenantId, productId])
}

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  isDefault Boolean  @default(false) // bodega principal (recibe los flujos sin bodega explícita)
  isActive  Boolean  @default(true)
  // Carga de ruta (Vendedores Fase B): si esta bodega es la CARGA de un
  // vendedor ("camioneta de Juan"), acá vive su User. Con carga asignada, las
  // ventas de ese vendedor descuentan de ESTA bodega (guard de suficiencia
  // incluido: no vendés lo que no cargaste). Nullable = bodega normal; el
  // unique de abajo garantiza a lo sumo UNA carga por vendedor (MySQL permite
  // múltiples NULL en índice único, así que las bodegas comunes no chocan).
  sellerId  String?
  createdAt DateTime @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  seller          User?            @relation("SellerLoadWarehouse", fields: [sellerId], references: [id])
  productStocks   ProductStock[]
  kardexMovements KardexMovement[]
  transfersFrom   StockTransfer[]  @relation("TransferFrom")
  transfersTo     StockTransfer[]  @relation("TransferTo")
  stockCounts     StockCount[]
  goodsReceipts   GoodsReceipt[]
  batchWarehouseStocks ProductBatchWarehouseStock[]
  batchLedgerEntries ProductBatchLedgerEntry[]
  saleItemBatchAllocations SaleItemBatchAllocation[]
  purchaseItemsWithInventoryEvidence PurchaseItem[] @relation("PurchaseItemInventoryWarehouse")
  supplierReturnItems SupplierReturnItem[]

  @@unique([tenantId, name])
  @@unique([tenantId, sellerId])
  @@index([tenantId])
}

model ProductStock {
  id          String @id @default(cuid())
  tenantId    String
  productId   String
  warehouseId String
  stock       Float  @default(0)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([productId])
}

// Transferencia entre bodegas (Fase 3): mueve existencias origen→destino de forma
// atómica. NO cambia Product.stock (el agregado no se mueve); items en Json
// (patrón de B2BOrder/ProductReturn). Ejecución inmediata (sin IN_TRANSIT en v1).
model StockTransfer {
  id              String   @id @default(cuid())
  tenantId        String
  fromWarehouseId String
  toWarehouseId   String
  // Nullable para transferencias históricas; nuevos comandos usan UUID + hash.
  clientEventId      String? @db.VarChar(128)
  payloadHash        String? @db.VarChar(64)
  payloadVersion     Int     @default(1)
  batchLedgerMode    String  @default("OFF") @db.VarChar(16)
  batchTransferStatus String @default("OFF") @db.VarChar(32)
  batchSnapshot      Json?
  notes           String?  @db.Text
  items           Json // [{productId, name, quantity}]
  createdBy       String
  createdAt       DateTime @default(now())

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])

  @@index([tenantId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@unique([tenantId, clientEventId])
  // El listado ordena por tenant+createdAt desc (guardrail 3: índice con la query).
  @@index([tenantId, createdAt])
}

// ==========================================
// CONTROL DE LOTES Y VENCIMIENTOS
// ==========================================

model ProductBatch {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  batchNumber String // Número de lote
  expiryDate  DateTime // Fecha de vencimiento
  stock       Float    @default(0) // Stock restante del lote
  createdAt   DateTime @default(now())

  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product             Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  kardexMovements     KardexMovement[]
  saleItemAllocations SaleItemBatchAllocation[]
  goodsReceiptItems   GoodsReceiptItem[]
  warehouseStocks     ProductBatchWarehouseStock[]
  ledgerEntries       ProductBatchLedgerEntry[]
  purchaseItemsWithInventoryEvidence PurchaseItem[] @relation("PurchaseItemInventoryBatch")
  supplierReturnItems SupplierReturnItem[]

  @@unique([productId, batchNumber])
  @@index([tenantId])
  @@index([productId])
  @@index([expiryDate])
}

/// Desglose autoritativo de un lote por bodega cuando el tenant activa el ledger.
/// No se reparten existencias históricas desde DDL; el servicio hará shadow lazy.
model ProductBatchWarehouseStock {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  batchId     String
  warehouseId String
  stock       Decimal  @default(0) @db.Decimal(18, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch     ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  warehouse Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([tenantId, batchId, warehouseId])
  @@index([tenantId, batchId])
  @@index([tenantId, productId, warehouseId])
  @@index([tenantId, warehouseId, productId])
}

/// Libro inmutable del stock de lote por bodega. sourceKey y payloadHash hacen
/// seguros los reintentos; stockBefore/After permiten auditar cada transición.
model ProductBatchLedgerEntry {
  id            String   @id @default(cuid())
  tenantId      String
  productId     String
  batchId       String
  warehouseId   String
  quantityDelta Decimal  @db.Decimal(18, 4)
  stockBefore   Decimal  @db.Decimal(18, 4)
  stockAfter    Decimal  @db.Decimal(18, 4)
  movementType  String   @db.VarChar(32)
  status        String   @default("APPLIED") @db.VarChar(32) // APPLIED | SHADOW_GAP
  referenceId   String?
  referenceType String?  @db.VarChar(64)
  sourceKey     String   @db.VarChar(191)
  payloadHash   String   @db.VarChar(64)
  reason        String?  @db.Text
  userId        String
  createdAt     DateTime @default(now())

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch     ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  warehouse Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  creator   User         @relation("ProductBatchLedgerEntryCreator", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, sourceKey])
  @@index([tenantId, batchId, createdAt])
  @@index([tenantId, warehouseId, createdAt])
  @@index([tenantId, productId, warehouseId, createdAt])
  @@index([tenantId, referenceType, referenceId])
  @@index([userId])
}

// ==========================================
// CONTROL DE SERIES (números de serie por unidad)
// ==========================================

model SerialNumber {
  id         String   @id @default(cuid())
  tenantId   String
  productId  String
  serial     String // número de serie / IMEI / VIN
  status     String   @default("IN_STOCK") // IN_STOCK | SOLD | RETURNED | VOID
  saleId     String? // venta donde salió la unidad
  purchaseId String? // compra/recepción donde entró
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale     Sale?     @relation(fields: [saleId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id])

  @@unique([productId, serial])
  @@index([tenantId])
  @@index([productId])
  @@index([status])
  @@index([serial])
}

// ==========================================
// TOMA FÍSICA / CONTEO CÍCLICO (Bodeguero B1)
// ==========================================

model StockCount {
  id               String    @id @default(cuid())
  tenantId         String
  warehouseId      String? // null = conteo histórico anterior al alcance por bodega
  openWarehouseKey String?   @unique // warehouseId mientras OPEN; null al cerrar/cancelar
  status           String    @default("OPEN") // OPEN | CLOSING | CLOSED | CANCELLED
  scope            String    @default("ALL") // ALL | CATEGORY
  category         String? // si scope=CATEGORY
  notes            String?   @db.Text
  createdBy        String
  createdAt        DateTime  @default(now())
  closedAt         DateTime?
  closedBy         String? // userId que cerró (sin relación, solo traza)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // El historial de un conteo es evidencia auditable: una bodega referenciada
  // no se elimina físicamente (se desactiva), para no borrar su procedencia.
  warehouse Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  creator   User             @relation(fields: [createdBy], references: [id])
  items     StockCountItem[]

  @@index([tenantId])
  @@index([status])
  @@index([warehouseId])
  @@index([tenantId, warehouseId, status])
}

model StockCountItem {
  id        String    @id @default(cuid())
  countId   String
  productId String
  expected  Float // snapshot del stock del sistema al crear el conteo
  counted   Float? // conteo físico capturado (null = aún no contado)
  diff      Float     @default(0) // counted - expected (calculado al cerrar)
  countedAt DateTime?

  count   StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([countId, productId])
  @@index([countId])
  @@index([productId])
}

// ==========================================
// PAGOS MANUALES (DEPÓSITO / TRANSFERENCIA)
// ==========================================

model ManualPayment {
  id              String    @id @default(cuid())
  tenantId        String
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @default("USD") // USD | NIO
  bank            String // Banco destino (BAC, Lafise, etc.)
  referenceNumber String // Número de referencia del voucher
  proofUrl        String?   @db.Text // URL/ruta de la foto del comprobante
  notes           String?   @db.Text
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason String?   @db.Text
  reviewedBy      String? // userId del admin que revisó
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
}

// ==========================================
// QUOTATIONS (COTIZACIONES)
// ==========================================

model Quotation {
  id                  String   @id @default(cuid())
  tenantId            String
  customerName        String
  customerRuc         String?
  subtotal            Decimal  @db.Decimal(10, 2)
  tax                 Decimal  @db.Decimal(10, 2)
  // Snapshot fiscal de la cotización; GENERAL conserva el formato histórico.
  fiscalRegimeAtQuote String   @default("GENERAL") @db.VarChar(32)
  total               Decimal  @db.Decimal(10, 2)
  status              String   @default("SENT") // SENT | CONVERTED | EXPIRED
  createdAt           DateTime @default(now())
  expiresAt           DateTime

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  items  QuotationItem[]

  @@index([tenantId])
}

model QuotationItem {
  id                          String   @id @default(cuid())
  quotationId                 String
  productId                   String
  quantity                    Int
  quantityExact               Decimal? @db.Decimal(18, 4)
  price                       Decimal  @db.Decimal(10, 2)
  unitPriceExact              Decimal? @db.Decimal(18, 4)
  unitAtQuote                 String?
  saleModeAtQuote             String?
  quantityStepAtQuote         Decimal? @db.Decimal(18, 4)
  presentationAtQuote         String? // BASE | PACK
  presentationQuantityAtQuote Decimal? @db.Decimal(18, 4)
  ivaExentoAtQuote            Boolean?
  name                        String // Snapshot name

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

// ==========================================
// 🔄 DEVOLUCIONES / NOTAS DE CRÉDITO
// ==========================================

model ProductReturn {
  id            String   @id @default(cuid())
  tenantId      String
  saleId        String
  processedShiftId String?
  total         Decimal  @db.Decimal(10, 2) // Total del reembolso
  reason        String   @db.Text
  items         Json // [{productId, name, quantity, price}]
  createdBy     String
  // Nullable solo para filas históricas. La API actual exige clientEventId y
  // escribe siempre su huella SHA-256 canónica en la misma transacción.
  clientEventId String?  @db.VarChar(128)
  payloadHash   String?  @db.VarChar(64)
  // Expediente profesional. Nullable para conservar devoluciones históricas.
  correctionRequestId String?  @unique
  returnNumber        Int?
  resolution          String   @default("REFUND") @db.VarChar(32) // REFUND | EXCHANGE | STORE_CREDIT
  refundStatus        String   @default("NOT_REQUIRED") @db.VarChar(32) // NOT_REQUIRED | PENDING | COMPLETED
  createdAt     DateTime @default(now())

  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  sale              Sale                   @relation(fields: [saleId], references: [id])
  processedShift    Shift?                 @relation("ProcessedShiftReturns", fields: [processedShiftId], references: [id])
  correctionRequest SaleCorrectionRequest? @relation(fields: [correctionRequestId], references: [id], onDelete: Restrict)
  normalizedItems   ProductReturnItem[]
  refunds           ReturnRefund[]
  creditEntries     CustomerCreditEntry[]

  @@unique([tenantId, clientEventId])
  @@index([tenantId])
  @@index([saleId])
  @@unique([tenantId, returnNumber])
  @@index([tenantId, createdAt])
  @@index([tenantId, processedShiftId, createdAt])
}

/// Solicitud aprobable que precede cualquier movimiento de dinero o inventario.
/// `APPROVED` concede permiso, pero únicamente `COMPLETED` confirma que la
/// transacción de negocio se ejecutó y fue revalidada bajo locks.
model SaleCorrectionRequest {
  id              String   @id @default(cuid())
  tenantId        String
  saleId          String
  kind            String   @db.VarChar(16) // RETURN | VOID
  status          String   @default("PENDING_APPROVAL") @db.VarChar(32)
  reason          String   @db.Text
  resolution      String?  @db.VarChar(32) // REFUND | EXCHANGE | STORE_CREDIT
  refundMethod    String?  @db.VarChar(16) // CASH | CARD | QR | TRANSFER
  requestedBy     String
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?  @db.Text
  executedBy      String?
  executedAt      DateTime?
  expiresAt       DateTime?
  clientEventId   String   @db.VarChar(128)
  payloadHash     String   @db.VarChar(64)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sale          Sale                 @relation(fields: [saleId], references: [id], onDelete: Restrict)
  lines         SaleCorrectionLine[]
  productReturn ProductReturn?
  refunds       ReturnRefund[]

  @@unique([tenantId, clientEventId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, saleId, createdAt])
  @@index([approvedBy])
  @@index([requestedBy])
}

model SaleCorrectionLine {
  id             String   @id @default(cuid())
  tenantId       String
  requestId      String
  saleItemId     String
  quantity       Decimal  @db.Decimal(18, 4)
  disposition    String   @default("RESTOCK") @db.VarChar(16) // RESTOCK | QUARANTINE | LOSS
  createdAt      DateTime @default(now())

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  request    SaleCorrectionRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  saleItem   SaleItem              @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  inspection ReturnInspection?

  @@unique([requestId, saleItemId])
  @@index([tenantId, requestId])
  @@index([tenantId, saleItemId])
}

/// Línea normalizada final. El JSON de ProductReturn continúa escribiéndose
/// como snapshot compatible, pero las consultas nuevas no dependen de parsearlo.
model ProductReturnItem {
  id                 String   @id @default(cuid())
  tenantId           String
  productReturnId    String
  saleItemId         String
  productId          String
  quantity           Decimal  @db.Decimal(18, 4)
  refundUnitPrice    Decimal  @db.Decimal(18, 4)
  lineTotal          Decimal  @db.Decimal(18, 4)
  costTotal          Decimal  @db.Decimal(18, 4)
  disposition        String   @db.VarChar(16)
  productNameAtReturn String? @db.VarChar(191)
  unitAtReturn       String?  @db.VarChar(32)
  createdAt          DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  productReturn ProductReturn @relation(fields: [productReturnId], references: [id], onDelete: Restrict)
  saleItem      SaleItem      @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productReturnId, saleItemId])
  @@index([tenantId, productReturnId])
  @@index([tenantId, productId])
}

/// Autorización fuerte y de un solo uso. Se persiste el hash, nunca el token.
model ApprovalGrant {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  tokenHash   String   @unique @db.VarChar(64)
  purpose     String   @db.VarChar(32) // SALE_CORRECTION
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, userId, expiresAt])
}

model ReturnRefund {
  id                  String   @id @default(cuid())
  tenantId            String
  saleId              String
  productReturnId     String?
  correctionRequestId String?
  amount              Decimal  @db.Decimal(18, 4)
  method              String   @db.VarChar(16)
  status              String   @default("PENDING") @db.VarChar(16) // PENDING | COMPLETED | CANCELLED
  externalReference   String?  @db.VarChar(191)
  evidenceNote        String?  @db.Text
  completedBy         String?
  completedAt         DateTime?
  createdAt           DateTime @default(now())

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sale              Sale                   @relation(fields: [saleId], references: [id], onDelete: Restrict)
  productReturn     ProductReturn?         @relation(fields: [productReturnId], references: [id], onDelete: Restrict)
  correctionRequest SaleCorrectionRequest? @relation(fields: [correctionRequestId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, saleId])
  @@index([productReturnId])
}

/// Existencia que volvió físicamente pero todavía no es vendible.
model ReturnInspection {
  id               String   @id @default(cuid())
  tenantId         String
  correctionLineId String   @unique
  productId        String
  quantity         Decimal  @db.Decimal(18, 4)
  status           String   @default("PENDING") @db.VarChar(16) // PENDING | RESTOCKED | DISCARDED
  batchEvidence    Json?
  resolvedBy       String?
  resolutionReason String?  @db.Text
  resolvedAt       DateTime?
  createdAt        DateTime @default(now())

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  correctionLine SaleCorrectionLine @relation(fields: [correctionLineId], references: [id], onDelete: Restrict)
  product        Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, productId])
}

model CustomerCreditEntry {
  id              String   @id @default(cuid())
  tenantId        String
  customerId      String
  productReturnId String?
  saleId          String?
  type            String   @db.VarChar(32) // RETURN_CREDIT | SALE_RETURN_CREDIT | EXCHANGE_DEBIT | VOID_RESTORE | ADJUSTMENT
  amount          Decimal  @db.Decimal(18, 4) // positivo acredita; negativo consume
  balanceAfter    Decimal  @db.Decimal(18, 4)
  createdBy       String
  createdAt       DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  productReturn ProductReturn? @relation(fields: [productReturnId], references: [id], onDelete: Restrict)
  sale          Sale?          @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([tenantId, customerId, createdAt])
  @@index([productReturnId])
  @@index([saleId])
}

// ==========================================
// 📊 CONTABILIDAD DE PARTIDA DOBLE (NIIF PyMES)
// ==========================================

model Account {
  id       String  @id @default(cuid())
  tenantId String
  code     String // "1.1.1", "4.1.1", etc.
  name     String // "Caja General", "Inventario", "Ventas"
  type     String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  subtype  String? // CURRENT_ASSET, FIXED_ASSET, CURRENT_LIABILITY, etc.
  balance  Decimal @default(0) @db.Decimal(18, 4)
  isSystem Boolean @default(true) // Cuentas del sistema (no borrables)

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  lines  JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
}

model JournalEntry {
  id            String   @id @default(cuid())
  tenantId      String
  date          DateTime @default(now())
  economicDate  DateTime?
  postedAt      DateTime?
  description   String   @db.Text
  referenceId   String? // Sale.id, Purchase.id, etc.
  referenceType String? // SALE, PURCHASE, EXPENSE, PAYROLL, ADJUSTMENT, RETURN, PAYMENT
  isAutomatic   Boolean  @default(true)
  entryKind     String   @default("ORIGINAL") @db.VarChar(32)
  postingKey    String?  @db.VarChar(191)
  payloadHash   String?  @db.VarChar(64)
  reversalOfId  String?  @unique
  createdBy     String
  createdAt     DateTime @default(now())

  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  lines      JournalLine[]
  reversalOf JournalEntry? @relation("JournalEntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy JournalEntry? @relation("JournalEntryReversal")

  @@unique([tenantId, postingKey])
  @@index([tenantId])
  @@index([referenceId])
  @@index([date])
}

model JournalLine {
  id             String  @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal @default(0) @db.Decimal(18, 4)
  credit         Decimal @default(0) @db.Decimal(18, 4)

  entry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

model FiscalRetention {
  id          String   @id @default(cuid())
  tenantId    String
  type        String // IR_2PCT, IMI_1PCT, IVA_RETENIDO
  amount      Decimal  @db.Decimal(10, 2)
  baseAmount  Decimal  @db.Decimal(10, 2)
  supplierId  String?
  purchaseId  String?
  description String   @db.Text
  period      String // "2026-02"
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([period])
}

// ==========================================
// 🧾 FACTURACIÓN COMPUTARIZADA DGI
// ==========================================

model InvoiceSeries {
  id         String  @id @default(cuid())
  tenantId   String
  series     String  @default("A") // Serie de factura (A, B, etc.)
  lastNumber Int     @default(0) // Último consecutivo emitido
  rangeStart Int     @default(1) // Rango autorizado DGI: desde
  rangeEnd   Int     @default(999999) // Rango autorizado DGI: hasta
  isActive   Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, series])
  @@index([tenantId])
}

// ==========================================
// HR: NICALABOR ENGINE & MICRO-LENDING
// ==========================================

model LeaveRequest {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  type       String // SICK, VACATION, UNPAID, MATERNITY
  startDate  DateTime
  endDate    DateTime
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reason     String?  @db.Text
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
}

model PayrollRun {
  id          String   @id @default(cuid())
  tenantId    String
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Decimal  @default(0) @db.Decimal(10, 2)
  status      String   @default("DRAFT") // DRAFT, APPROVED, PAID

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  payrollLines PayrollLine[]

  @@index([tenantId])
}

model PayrollLine {
  id                String  @id @default(cuid())
  tenantId          String
  payrollRunId      String
  employeeId        String
  basePay           Decimal @db.Decimal(10, 2)
  overtimePay       Decimal @default(0) @db.Decimal(10, 2)
  commissions       Decimal @default(0) @db.Decimal(10, 2)
  bonuses           Decimal @default(0) @db.Decimal(10, 2)
  inssDeduction     Decimal @default(0) @db.Decimal(10, 2)
  irDeduction       Decimal @default(0) @db.Decimal(10, 2)
  advanceDeductions Decimal @default(0) @db.Decimal(10, 2)
  netPay            Decimal @db.Decimal(10, 2)

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  payrollRun   PayrollRun      @relation(fields: [payrollRunId], references: [id])
  employee     Employee        @relation(fields: [employeeId], references: [id])
  advancesPaid SalaryAdvance[]

  @@index([tenantId])
  @@index([payrollRunId])
  @@index([employeeId])
}

model SalaryAdvance {
  id                 String  @id @default(cuid())
  tenantId           String
  employeeId         String
  amount             Decimal @db.Decimal(10, 2)
  fee                Decimal @default(0) @db.Decimal(10, 2)
  status             String  @default("PENDING") // PENDING, APPROVED, REJECTED, DEDUCTED
  repaymentPayrollId String?
  // Fase A RRHH: enlaza el adelanto a la nómina (Payroll) donde se descontó.
  payrollId          String?

  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  employee         Employee     @relation(fields: [employeeId], references: [id])
  repaymentPayroll PayrollLine? @relation(fields: [repaymentPayrollId], references: [id])
  payroll          Payroll?     @relation(fields: [payrollId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([repaymentPayrollId])
  @@index([payrollId])
}

model TerminationSettlement {
  id              String   @id @default(cuid())
  tenantId        String
  employeeId      String   @unique
  terminationDate DateTime
  reason          String // RESIGNATION, DISMISSAL, JUSTIFIED
  aguinaldoAmount Decimal  @default(0) @db.Decimal(10, 2)
  vacationAmount  Decimal  @default(0) @db.Decimal(10, 2)
  severanceAmount Decimal  @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal  @default(0) @db.Decimal(10, 2)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
}

// ==========================================
// 🌐 PEDIDOS PÚBLICOS (PORTAL WEB)
// ==========================================

model PublicOrder {
  id            String   @id @default(cuid())
  tenantId      String
  customerName  String
  customerPhone String?
  items         Json // [{productId, name, quantity, price}]
  status        String   @default("PENDING") // PENDING | CONVERTED
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
}

// ==========================================
// 💰 NORTEX CAPITAL (EMBEDDED LENDING)
// ==========================================

model CapitalLoan {
  id               String   @id @default(cuid())
  tenantId         String
  amount           Decimal  @db.Decimal(12, 2) // Monto prestado
  interestRate     Decimal  @db.Decimal(5, 4) // 0.05 = 5%
  totalDue         Decimal  @db.Decimal(12, 2) // amount * (1 + rate)
  dueDate          DateTime // Vencimiento
  status           String   @default("ACTIVE") // ACTIVE | PAID | DEFAULTED
  linkedPurchaseId String?  @unique // Compra financiada (1:1)
  createdAt        DateTime @default(now())

  // Tamper-evidence: HMAC de los términos inmutables del préstamo al originarse
  signature String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  purchase Purchase? @relation(fields: [linkedPurchaseId], references: [id])

  @@index([tenantId])
  @@index([status])
}

model Motorizado {
  id                   String   @id @default(uuid())
  tenantId             String? // Opcional: Si es nulo, es un motorizado global de Nortex
  tipoFlota            String   @default("PROPIA") // "PROPIA" (de la ferretería) o "NORTEX" (freelance)
  nombre               String   @db.VarChar(100)
  telefono             String   @db.VarChar(20)
  zonaCobertura        String   @db.VarChar(100)
  activo               Boolean  @default(true)
  walletId             String?  @unique // ¡Su propia cuenta bancaria Nortex!
  calificacionPromedio Float    @default(5.0)
  vehiculoPlaca        String?  @db.VarChar(20)
  createdAt            DateTime @default(now())

  // ── Red NORTEX: registro público + KYC + login teléfono+PIN ──
  cedula          String? @db.VarChar(25) // Cédula de identidad (KYC)
  pinHash         String? // bcrypt del PIN — login del driver (reemplaza el magic-link)
  kycStatus       String  @default("PENDIENTE") // PENDIENTE | APROBADO | RECHAZADO
  kycNota         String? @db.Text // Motivo de rechazo / notas del revisor
  fotoCedulaUrl   String? // KYC: foto de la cédula (Cloudinary)
  fotoVehiculoUrl String? // KYC: foto de la moto con placa visible (Cloudinary)

  // ── FASE 3: Wallet del Real Money Protocol ──
  // PROYECCIÓN del saldo — la verdad es el libro firmado (DriverWalletMovement).
  // Se verifica recomputando contra la cadena; jamás se firma el saldo mutable.
  walletBalance Decimal @default(0) @db.Decimal(12, 2)

  tenant      Tenant?                @relation(fields: [tenantId], references: [id])
  pedidos     Pedido[]
  movimientos DriverWalletMovement[]

  @@index([tenantId])
  @@index([telefono])
  @@index([kycStatus])
}

// ══════════════════════════════════════════════════════════════════════════
// FASE A — Períodos fiscales (bloqueo del cierre)
// Una fila existe SOLO cuando el período fue cerrado (o reabierto). Sin fila →
// el período se trata como ABIERTO (no rompe los flujos existentes). El guard
// assertPeriodOpen bloquea cualquier asiento cuya fecha caiga en CLOSED.
// ══════════════════════════════════════════════════════════════════════════
model FiscalPeriod {
  id           String    @id @default(cuid())
  tenantId     String
  year         Int
  month        Int // 1-12
  status       String    @default("CLOSED") // CLOSED | OPEN (reabierto)
  closedBy     String?
  closedAt     DateTime?
  reopenedBy   String?
  reopenedAt   DateTime?
  reopenReason String?   @db.Text
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, year, month])
  @@index([tenantId])
}

// ══════════════════════════════════════════════════════════════════════════
// FASE B — Cumplimiento (parte 1): parametrización + retenciones sufridas
// ══════════════════════════════════════════════════════════════════════════

// B4 — Tasas fiscales por tenant. Las constantes del código pasan a defaults;
// el contador ajusta según el contribuyente (INSS 21.5/<50 emp · 22.5/≥50,
// Anticipo IR/PMD 1-3%, IMI por alcaldía).
model TaxConfig {
  tenantId         String   @id
  inssPatronalRate Decimal  @default(0.225) @db.Decimal(6, 4)
  anticipoIrRate   Decimal  @default(0.0100) @db.Decimal(6, 4)
  imiRate          Decimal  @default(0.0100) @db.Decimal(6, 4)
  salarioMinimo    Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt        DateTime @updatedAt
}

// B6 — Tipo de cambio (deslizamiento del córdoba). Mata el 36.56 hardcodeado.
// Se usa la fila con fecha <= hoy más reciente. Carga manual o semilla BCN.
model ExchangeRate {
  id        String   @id @default(cuid())
  tenantId  String
  fecha     DateTime @db.Date
  rate      Decimal  @db.Decimal(10, 4) // C$ por US$
  source    String   @default("MANUAL") // MANUAL | BCN
  createdAt DateTime @default(now())

  @@unique([tenantId, fecha])
  @@index([tenantId, fecha])
}

// B1 — Retención SUFRIDA: el cliente (empresa/Estado) le retuvo IR 2% / IMI 1%
// al negocio. Es CRÉDITO contra el Anticipo IR del mes → deja de pagar de más.
model RetencionSufrida {
  id               String   @id @default(cuid())
  tenantId         String
  fecha            DateTime
  clienteRetenedor String   @db.VarChar(160)
  tipo             String // IR_2 | IMI_1
  baseAmount       Decimal  @db.Decimal(12, 2)
  amount           Decimal  @db.Decimal(12, 2)
  numeroConstancia String?  @db.VarChar(60)
  saleId           String?
  // Nullable solo para históricos y clientes legacy. Los clientes nuevos
  // conservan este UUID entre reintentos de la misma operación lógica.
  clientEventId    String?  @db.VarChar(128)
  payloadHash      String?  @db.VarChar(64)
  createdBy        String
  createdAt        DateTime @default(now())

  @@unique([tenantId, clientEventId])
  @@index([tenantId, fecha])
}

// ══════════════════════════════════════════════════════════════════════════
// FASE B parte 2 — Activos fijos + depreciación (Ley 822)
// ══════════════════════════════════════════════════════════════════════════
model FixedAsset {
  id               String   @id @default(cuid())
  tenantId         String
  nombre           String   @db.VarChar(160)
  categoria        String // EDIFICIO | VEHICULO | MAQUINARIA | MOBILIARIO | COMPUTO | OTRO
  costo            Decimal  @db.Decimal(14, 2)
  fechaAdquisicion DateTime @db.Date
  vidaUtilMeses    Int // método de línea recta (cuota = costo / vidaUtilMeses)

  depreciacionAcumulada Decimal @default(0) @db.Decimal(14, 2)
  mesesDepreciados      Int     @default(0)
  // "YYYY-MM" de la última cuota posteada → idempotencia del corrido mensual.
  ultimoPeriodoDep      String?
  estado                String  @default("ACTIVO") // ACTIVO | BAJA

  createdBy String
  createdAt DateTime @default(now())

  movimientos DepreciationEntry[]

  @@index([tenantId])
  @@index([estado])
}

// Cuota mensual posteada (auditoría + idempotencia dura por @@unique).
model DepreciationEntry {
  id        String   @id @default(cuid())
  assetId   String
  tenantId  String
  year      Int
  month     Int
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  asset FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, year, month])
  @@index([tenantId])
}

// ══════════════════════════════════════════════════════════════════════════
// FASE C — Panel del contador: estado de obligaciones del mes (checklist)
// ══════════════════════════════════════════════════════════════════════════
model ObligationStatus {
  id        String    @id @default(cuid())
  tenantId  String
  year      Int
  month     Int
  key       String // IVA | ANTICIPO_IR | IMI | INSS | INATEC
  declarado Boolean   @default(false)
  markedBy  String?
  markedAt  DateTime?
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, year, month, key])
  @@index([tenantId])
}

// el UPDATE con increment toma row-lock → serializa los appends del driver).
model DriverLedgerHead {
  motorizadoId String   @id
  lastSeq      Int      @default(0)
  lastHash     String   @default("GENESIS")
  updatedAt    DateTime @updatedAt
}

// Libro inmutable del wallet del repartidor (tamper-evidence).
// amount: + acredita (comisión por entrega), − debita (pago de Nortex al driver).
model DriverWalletMovement {
  id           String   @id @default(cuid())
  motorizadoId String
  tenantId     String? // Negocio para el que se repartió (null en pagos/ajustes de plataforma)
  pedidoId     String?  @unique // 1 entrega = 1 comisión (idempotencia a nivel de DB)
  type         String // COMISION_ENTREGA | PAGO_NORTEX | AJUSTE
  amount       Decimal  @db.Decimal(12, 2)
  descripcion  String   @db.Text
  createdAt    DateTime @default(now())

  // Cadena firmada (mismo esquema que CashMovement): null = legacy/sin claves.
  seq       Int?
  prevHash  String?
  signature String?

  motorizado Motorizado @relation(fields: [motorizadoId], references: [id])

  @@unique([motorizadoId, seq])
  @@index([motorizadoId])
  @@index([type])
}

model Pedido {
  id                  String    @id @default(uuid())
  tenantId            String
  clienteNombre       String    @db.VarChar(100)
  clienteTelefono     String    @db.VarChar(20)
  direccionEntrega    String    @db.Text
  referenciaDireccion String?   @db.Text
  motorizadoId        String?
  estado              String    @default("pendiente") // pendiente, preparando, en_camino, entregado, cancelado
  total               Decimal   @db.Decimal(10, 2)
  costoEntrega        Decimal   @db.Decimal(10, 2)
  facturaId           String?
  notas               String?   @db.Text
  createdAt           DateTime  @default(now())
  entregadoAt         DateTime?
  distanciaEstimada   Float? // Distancia en KM
  tiempoEntregaReal   Int? // Tiempo en minutos

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  motorizado Motorizado?      @relation(fields: [motorizadoId], references: [id])
  factura    Sale?            @relation(fields: [facturaId], references: [id])
  items      PedidoItem[]
  eventos    TrackingEvento[]

  @@index([tenantId])
  @@index([motorizadoId])
  @@index([facturaId])
}

model PedidoItem {
  id                         String   @id @default(uuid())
  pedidoId                   String
  productoId                 String
  cantidad                   Int
  cantidadExact              Decimal? @db.Decimal(18, 4)
  presentationAtSale         String? // BASE | PACK, snapshot desde el pedido
  presentationQuantityAtSale Decimal? @db.Decimal(18, 4)
  productNameAtOrder         String?
  unitAtOrder                String?
  saleModeAtOrder            String?
  quantityStepAtOrder        Decimal? @db.Decimal(18, 4)
  unitPriceExactAtOrder      Decimal? @db.Decimal(18, 4)
  ivaExentoAtOrder           Boolean?
  precioUnitario             Decimal  @db.Decimal(10, 2)
  subtotal                   Decimal  @db.Decimal(10, 2)

  pedido   Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Product @relation(fields: [productoId], references: [id])

  @@index([pedidoId])
  @@index([productoId])
}

model TrackingEvento {
  id        String   @id @default(uuid())
  pedidoId  String
  estado    String
  nota      String?  @db.Text
  lat       Float? // GPS tracking
  lng       Float? // GPS tracking
  createdAt DateTime @default(now())

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
}

// ==========================================
// 🦄 MÓDULO NORTEX PRESTAMISTAS (AISLADO)
// ==========================================

enum LoanType {
  INFORMAL_FLAT // Préstamo de calle (Gota a Gota), interés fijo desde el día 1
  FORMAL_AMORTIZED // Préstamo de financiera, interés sobre saldo
}

enum PaymentFrequency {
  DAILY // Diario (Típico informal)
  WEEKLY // Semanal
  BIWEEKLY // Quincenal
  MONTHLY // Mensual (Típico financiera)
}

enum LoanStatus {
  PENDING
  ACTIVE
  DEFAULTED // En mora / incobrable
  PAID_OFF // Pagado totalmente
}

model Loan {
  id       String  @id @default(uuid())
  // Relaciones (Opcionales si el cliente no está en el sistema Nortex aún)
  tenantId String? // Si le prestamos a una Ferretería Nortex
  lenderId String // El Tenant que está prestando la plata

  // Enlace CRM
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Datos del Cliente Externo (Para préstamos de calle)
  clientName    String
  clientPhone   String?
  clientAddress String?

  // Configuración del Dinero
  type      LoanType         @default(INFORMAL_FLAT)
  frequency PaymentFrequency @default(DAILY)

  principalAmount  Decimal @db.Decimal(12, 2) // Capital prestado
  interestRate     Decimal @db.Decimal(5, 2) // Tasa de interés (%)
  totalToRepay     Decimal @db.Decimal(12, 2) // Capital + Interés (Flat)
  balanceRemaining Decimal @db.Decimal(12, 2) // Cuánto debe a hoy

  installments      Int // Número de cuotas (ej: 30 días)
  installmentAmount Decimal @db.Decimal(10, 2) // De a cuánto toca la cuota

  status      LoanStatus @default(ACTIVE)
  disbursedAt DateTime   @default(now())
  dueDate     DateTime // Fecha límite final

  // Historial de cobros
  payments Repayment[]

  // Plan de cuotas (Cobranza B2)
  schedule LoanInstallment[]

  // Asignación de Ruta (Motorizado encargado de cobrar)
  assignedToId String?
  assignedTo   User?   @relation("LoanCollector", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Índices (Fase 0 blindaje): la cartera filtra por lenderId y ordena por
  // createdAt; el cobrador filtra por assignedToId; los reportes por estado.
  @@index([lenderId, createdAt])
  @@index([lenderId, status])
  @@index([assignedToId])
}

// Cuota del plan de pago de un préstamo (Cobranza B2)
model LoanInstallment {
  id         String   @id @default(uuid())
  loanId     String
  number     Int // Nº de cuota (1..n)
  dueDate    DateTime // Vencimiento de la cuota
  amountDue  Decimal  @db.Decimal(10, 2)
  amountPaid Decimal  @default(0) @db.Decimal(10, 2)
  status     String   @default("PENDING") // PENDING | PARTIAL | PAID
  createdAt  DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, number])
  @@index([loanId])
  @@index([dueDate])
}

model Repayment {
  id     String @id @default(uuid())
  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  amountPaid  Decimal  @db.Decimal(10, 2)
  paymentDate DateTime @default(now())
  collectedBy String? // Nombre del cobrador de la moto

  notes     String?  @db.Text
  createdAt DateTime @default(now())

  // Índices (Fase 0 blindaje): la cartera trae los pagos de hoy por préstamo,
  // filtrando por loanId + rango de paymentDate.
  @@index([loanId, paymentDate])
}

model RouteExpense {
  id          String   @id @default(uuid())
  lenderId    String // El Tenant prestamista
  collectedBy String // Nombre del motorizado
  amount      Decimal  @db.Decimal(10, 2)
  description String // "Gasolina Moto 1", "Pinchazo llanta"
  shiftId     String? // Turno vinculado
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  shift Shift? @relation(fields: [shiftId], references: [id])
}

// Entrega de efectivo del cobrador a la bóveda del prestamista (Cobranza A3)
model CollectorDeposit {
  id            String   @id @default(uuid())
  lenderId      String // El Tenant prestamista que recibe la entrega
  collectorId   String? // userId del cobrador (si está en el sistema)
  collectorName String? // Nombre del cobrador (respaldo de auditoría)
  amount        Decimal  @db.Decimal(12, 2) // Efectivo entregado
  notes         String?  @db.Text
  receivedBy    String // userId del jefe que registró la entrega
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([lenderId])
}

// ==========================================
// 📱 CANAL WHATSAPP
// ==========================================

model WhatsappSession {
  id          String   @id @default(cuid())
  userId      String   @unique
  tenantId    String
  threadId    String? // ID del hilo conversacional del LLM
  state       String   @default("CHAT")
  // Estados: CHAT, PENDING_CONFIRMATION, PROCESSING, ERROR
  pendingData Json? // Draft de venta antes de confirmar
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model WhatsappInboundMessage {
  id        String   @id @default(cuid())
  messageId String   @unique
  // ID de Meta (wamid.xxx). Sirve como dedup key.
  tenantId  String
  status    String   @default("PROCESSING")
  // Estados: PROCESSING, PROCESSED, FAILED.
  // Default PROCESSING para que retries puedan recuperar
  // mensajes que quedaron a medio procesar por crash.
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([createdAt]) // Para job de cleanup mensual
}
