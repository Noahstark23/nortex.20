{
  "name": "nortex-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx backend/server.ts",
    "db:preflight": "tsx scripts/run-deploy-schema-preflight.ts",
    "deploy:health": "node scripts/verify-deployed-release.mjs",
    "deploy:schema-smoke": "sh scripts/test-deploy-schema-upgrade.sh",
    "release:preflight": "sh scripts/run-release-preflight.sh",
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:mutation": "stryker run && node scripts/check-mutation-scope.cjs",
    "build:seo": "vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "mobile:sync": "npm run build && cap sync android",
    "mobile:assets": "npx @capacitor/assets generate --android",
    "mobile:open": "cap open android",
    "check:design": "node scripts/check-design-system.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "6.4.1",
    "@sentry/node": "^10.65.0",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "compression": "^1.8.0",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dexie": "^4.4.2",
    "driver.js": "^1.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.563.0",
    "node-cache": "^5.1.2",
    "prisma": "6.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "7.18.2",
    "recharts": "^3.7.0",
    "resend": "^4.0.0",
    "stripe": "^17.0.0",
    "swr": "^2.4.2",
    "tsx": "^4.23.12",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.0"
  },
  "overrides": {
    "qs": "6.15.3"
  }
